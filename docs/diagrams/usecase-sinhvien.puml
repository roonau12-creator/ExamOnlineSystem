@startuml usecase-sinhvien
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ranksep 60
skinparam nodesep 25
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F7F7F7
  BorderColor #666666
  ArrowColor #333333
}
skinparam note {
  BackgroundColor #FFFFDD
  BorderColor #AAAA55
}

actor "Sinh viên" as SV

rectangle "Hệ thống thi trực tuyến" {
  usecase "Đăng nhập"           as UC1
  usecase "Xem lịch thi"        as UC2
  usecase "Xem chi tiết kỳ thi" as UC3
  usecase "Bắt đầu thi"         as UC4
  usecase "Làm bài thi"         as UC5
  usecase "Nộp bài"             as UC6
  usecase "Xem kết quả thi"     as UC7

  usecase "Nhận đề thi"  as UC8
  usecase "Lưu đáp án"   as UC9

  SV -- UC1
  SV -- UC2
  SV -- UC3
  SV -- UC4
  SV -- UC5
  SV -- UC6
  SV -- UC7

  UC4 ..> UC8 : <<include>>
  UC5 ..> UC9 : <<include>>
  UC6 .> UC5 : <<extend>>
}

note top of UC4
  Điều kiện: Sinh viên đã đăng nhập,
  đủ điều kiện dự thi và đang trong
  thời gian thi.
end note
@enduml
