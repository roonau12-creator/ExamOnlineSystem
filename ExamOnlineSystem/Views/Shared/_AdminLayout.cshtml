@using ExamOnlineSystem.Utility
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Quản trị - ExamOnlineSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css"/>
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/ExamOnlineSystem.styles.css" asp-append-version="true"/>
</head>
<body class="d-flex flex-column min-vh-100" style="background-color: #f5f5f5;">
@{
    var nguoiDung = await UserManager.GetUserAsync(User);
    var hoTen = !string.IsNullOrWhiteSpace(nguoiDung?.HoTen) ? nguoiDung!.HoTen : (User.Identity?.Name ?? "Người dùng");
    var chuCai = hoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault()?.Substring(0, 1).ToUpper() ?? "?";
    var vaiTro = User.IsInRole(SD.Role_Admin) ? "Quản trị viên"
               : User.IsInRole(SD.Role_Teacher) ? "Giảng viên"
               : User.IsInRole(SD.Role_Student) ? "Sinh viên" : "";
}

<nav class="navbar navbar-dark bg-primary border-bottom border-warning border-3 sticky-top">
    <div class="container-fluid px-3">
        <div class="d-flex align-items-center gap-2">
            @* Nút mở menu trái trên màn hình nhỏ *@
            <button class="btn btn-outline-light btn-sm d-lg-none" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Mở menu">
                <i class="bi bi-list"></i>
            </button>
            <a class="navbar-brand d-flex align-items-center gap-2" asp-area="Customer" asp-controller="Home" asp-action="Index">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning text-primary"
                      style="width:36px;height:36px"><i class="bi bi-mortarboard-fill"></i></span>
                <span class="lh-sm">
                    <small class="d-block text-uppercase text-white-50" style="font-size:11px">Trang quản trị</small>
                    <span class="fw-semibold">ExamOnlineSystem</span>
                </span>
            </a>
        </div>

        <div class="dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-white" href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning text-dark fw-bold small"
                      style="width:32px;height:32px">@chuCai</span>
                <span class="lh-sm d-none d-sm-inline">
                    <span class="d-block">@hoTen</span>
                    <small class="text-white-50">@vaiTro</small>
                </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-area="Customer" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2"></i>Về trang chủ</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-area="Identity" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="d-flex flex-grow-1">
    @* Màn hình lớn: menu cố định bên trái. Màn hình nhỏ: menu trượt (offcanvas). *@
    <aside class="offcanvas-lg offcanvas-start bg-dark" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel"
           style="width:240px">
        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title text-white" id="adminSidebarLabel">Menu quản trị</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body p-0">
            <partial name="_AdminSideBarNav" />
        </div>
    </aside>

    <main role="main" class="flex-grow-1 p-4" style="min-width:0">
        @RenderBody()
    </main>
</div>

<footer class="bg-primary text-white-50 border-top border-warning border-3 small">
    <div class="container-fluid px-4 py-2 d-flex flex-column flex-md-row justify-content-between">
        <span>© @DateTime.Now.Year ExamOnlineSystem. Bảo lưu mọi quyền.</span>
        <span>Phiên bản 1.0.0</span>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/toastr/toastr.min.js"></script>
<script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/datatables/dataTables.min.js"></script>
<script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<partial name="_Notification" />
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
