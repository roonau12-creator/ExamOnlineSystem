@using ExamOnlineSystem.Utility
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - ExamOnlineSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css"/>
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/ExamOnlineSystem.styles.css" asp-append-version="true"/>
</head>
<body class="d-flex flex-column min-vh-100" style="background-color: #f5f5f5;">
@{
    var daDangNhap = User.Identity?.IsAuthenticated == true;
    var laQuanTri = User.IsInRole(SD.Role_Admin);
    var laGiangVien = User.IsInRole(SD.Role_Teacher);
    var vaoQuanTri = laQuanTri || laGiangVien;

    var nguoiDung = daDangNhap ? await UserManager.GetUserAsync(User) : null;
    var hoTen = !string.IsNullOrWhiteSpace(nguoiDung?.HoTen) ? nguoiDung!.HoTen : (User.Identity?.Name ?? "");
    var chuCai = hoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault()?.Substring(0, 1).ToUpper() ?? "?";
    var vaiTro = laQuanTri ? "Quản trị viên"
               : laGiangVien ? "Giảng viên"
               : User.IsInRole(SD.Role_Student) ? "Sinh viên" : "";
}

<nav class="navbar navbar-expand-lg navbar-dark bg-primary border-bottom border-warning border-3 sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center gap-2" asp-area="Customer" asp-controller="Home" asp-action="Index">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning text-primary"
                  style="width:38px;height:38px"><i class="bi bi-mortarboard-fill fs-5"></i></span>
            <span class="lh-sm">
                <small class="d-block text-uppercase text-white-50" style="font-size:11px">Hệ thống thi trực tuyến</small>
                <span class="fw-semibold">ExamOnlineSystem</span>
            </span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                aria-controls="mainNavbar" aria-expanded="false" aria-label="Mở menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto ms-lg-4">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i>Trang chủ</a>
                </li>
                @if (User.IsInRole(SD.Role_Student))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer" asp-controller="LichThi" asp-action="Index"><i class="bi bi-calendar-event me-1"></i>Lịch thi</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer" asp-controller="MonHoc" asp-action="Index"><i class="bi bi-book me-1"></i>Môn học</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer" asp-controller="KetQuaThi" asp-action="Index"><i class="bi bi-award me-1"></i>Kết quả thi</a>
                    </li>
                }
                @if (vaoQuanTri)
                {
                    @* Admin vào từ trang Khoa; giảng viên không có quyền vào Khoa nên đi thẳng tới Học phần *@
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="@(laQuanTri ? "Khoa" : "HocPhan")" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>Quản trị
                        </a>
                    </li>
                }
            </ul>

            @if (daDangNhap)
            {
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning text-dark fw-bold small"
                                  style="width:32px;height:32px">@chuCai</span>
                            <span class="lh-sm">
                                <span class="d-block text-white">@hoTen</span>
                                <small class="text-white-50">@vaiTro</small>
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (User.IsInRole(SD.Role_Student))
                            {
                                <li><a class="dropdown-item" asp-area="Customer" asp-controller="HoSo" asp-action="Index"><i class="bi bi-person-vcard me-2"></i>Hồ sơ cá nhân</a></li>
                                <li><a class="dropdown-item" asp-area="Customer" asp-controller="KetQuaThi" asp-action="Index"><i class="bi bi-award me-2"></i>Kết quả thi</a></li>
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li>
                                <form asp-area="Identity" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            }
            else
            {
                <ul class="navbar-nav gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Identity" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus me-1"></i>Đăng ký</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-warning btn-sm mt-1" asp-area="Identity" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập</a>
                    </li>
                </ul>
            }
        </div>
    </div>
</nav>

<div class="flex-grow-1">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="bg-primary text-white border-top border-warning border-3">
    <div class="container-fluid px-4 py-4">
        <div class="row g-4">
            <div class="col-md-5">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning text-primary"
                          style="width:32px;height:32px"><i class="bi bi-mortarboard-fill"></i></span>
                    <span class="fw-semibold">ExamOnlineSystem</span>
                </div>
                <p class="small text-white-50 mb-0">
                    Phần mềm quản lý ngân hàng câu hỏi và sinh đề thi ngẫu nhiên:
                    trắc nghiệm, tự luận hoặc kết hợp.
                </p>
            </div>

            <div class="col-6 col-md-3">
                <h6 class="text-uppercase text-warning small fw-bold mb-3">Liên kết</h6>
                <ul class="list-unstyled small mb-0">
                    <li class="mb-1"><a class="link-light text-decoration-none" asp-area="Customer" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    @if (vaoQuanTri)
                    {
                        <li class="mb-1"><a class="link-light text-decoration-none" asp-area="Admin" asp-controller="HocPhan" asp-action="Index">Học phần</a></li>
                        <li class="mb-1"><a class="link-light text-decoration-none" asp-area="Admin" asp-controller="MonHoc" asp-action="Index">Môn học</a></li>
                    }
                    @if (!daDangNhap)
                    {
                        <li class="mb-1"><a class="link-light text-decoration-none" asp-area="Identity" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                    }
                </ul>
            </div>

            <div class="col-6 col-md-4">
                <h6 class="text-uppercase text-warning small fw-bold mb-3">Hỗ trợ</h6>
                <ul class="list-unstyled small mb-0">
                    <li class="mb-1 text-white-50"><i class="bi bi-envelope me-1"></i>hotro@example.vn</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="bg-dark bg-opacity-25">
        <div class="container-fluid px-4 py-2 d-flex flex-column flex-md-row justify-content-between small text-white-50">
            <span>© @DateTime.Now.Year ExamOnlineSystem. Bảo lưu mọi quyền.</span>
            <span>Phiên bản 1.0.0</span>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/toastr/toastr.min.js"></script>
<script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/datatables/dataTables.min.js"></script>
<script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/tabthi.js" asp-append-version="true"></script>
<partial name="_Notification" />
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
