@using ExamOnlineSystem.Models.ViewModels
@using ExamOnlineSystem.Utility
@model KetQuaLamBaiVM
@{
    ViewData["Title"] = "Đã nộp bài";
    var batDau = Model.ThoiGianBatDau.ToLocalTime();
    var nopBai = Model.ThoiGianNopBai?.ToLocalTime();
}

<div class="container-xl py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-3">
                <div class="card-body text-center py-4">
                    @if (Model.TrangThai == 3)
                    {
                        <i class="bi bi-slash-circle-fill text-danger" style="font-size: 3rem"></i>
                        <h4 class="mt-2 mb-1 text-danger">Bạn đã bị đình chỉ thi</h4>
                        <div class="small text-danger mb-2">Bạn đã mở hoặc chuyển sang tab khác trong lúc làm bài.</div>
                    }
                    else if (Model.TrangThai == 2)
                    {
                        <i class="bi bi-clock-history text-warning" style="font-size: 3rem"></i>
                        <h4 class="mt-2 mb-1">Hết giờ – bài đã được nộp tự động</h4>
                    }
                    else
                    {
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem"></i>
                        <h4 class="mt-2 mb-1">Đã nộp bài thành công</h4>
                    }
                    <div class="text-muted">@Model.TenMonHoc · @Model.TenLichThi</div>
                    <div class="small text-muted">@Model.HoTen · @Model.MaSinhVien · mã đề @Model.MaDeThi@(Model.LanThu > 1 ? $" · lần thi {Model.LanThu}" : "")</div>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white"><h5 class="mb-0"><i class="bi bi-clipboard-data"></i> Thông tin bài làm</h5></div>
                <div class="card-body">
                    <div class="row g-3 text-center">
                        <div class="col-6 col-md-3">
                            <div class="fs-4 fw-bold">@Model.SoCauDaLam/@Model.SoCau</div>
                            <div class="small text-muted">câu đã làm</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="fs-4 fw-bold @(Model.SoCauBoTrong > 0 ? "text-danger" : "")">@Model.SoCauBoTrong</div>
                            <div class="small text-muted">câu bỏ trống</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="fs-4 fw-bold">@(Model.SoPhutLamBai?.ToString() ?? "—")</div>
                            <div class="small text-muted">phút làm bài</div>
                        </div>
                        <div class="col-6 col-md-3">
                            @if (Model.ChoCham)
                            {
                                <div class="fs-4 fw-bold text-muted">—</div>
                                <div class="small text-muted">chờ chấm</div>
                            }
                            else
                            {
                                <div class="fs-4 fw-bold text-success">@(Model.DiemHe10?.ToString("0.##") ?? "—")</div>
                                <div class="small text-muted">điểm (hệ 10)</div>
                            }
                        </div>
                    </div>

                    <hr />
                    <div class="row small">
                        <div class="col-md-6">
                            <div><span class="text-muted">Bắt đầu:</span> @batDau.ToString("HH:mm:ss dd/MM/yyyy")</div>
                            <div><span class="text-muted">Nộp bài:</span> @(nopBai?.ToString("HH:mm:ss dd/MM/yyyy") ?? "—")</div>
                        </div>
                        <div class="col-md-6">
                            <div><span class="text-muted">Trạng thái:</span> @KetQuaLabel.TenTrangThaiLanThi(Model.TrangThai)</div>
                            <div>
                                <span class="text-muted">Điểm:</span>
                                @if (Model.ChoCham)
                                {
                                    <span>chờ giảng viên chấm @Model.SoCauTuLuan câu tự luận</span>
                                }
                                else
                                {
                                    <span>@Model.Diem?.ToString("0.##")/@Model.TongDiem.ToString("0.##") · @Model.XepLoai</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (Model.ChoCham)
                    {
                        <div class="alert alert-info small mt-3 mb-0">
                            <i class="bi bi-info-circle"></i> Bài có câu tự luận nên điểm chỉ hiện sau khi giảng viên chấm.
                            Điểm phần trắc nghiệm đã được chấm tự động.
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="LichThi" asp-action="ChiTiet" asp-route-id="@Model.LichThiId" class="btn btn-outline-secondary">
                    <i class="bi bi-calendar-event"></i> Chi tiết kỳ thi
                </a>
                <a asp-controller="KetQuaThi" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-award"></i> Kết quả thi của tôi
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-link">Về trang chủ</a>
            </div>
        </div>
    </div>
</div>
