@using ExamOnlineSystem.Utility
@{
    ViewData["Title"] = "Trang chủ";
    var daDangNhap = User.Identity?.IsAuthenticated == true;
}

<div class="container-xl">
<div class="row justify-content-center py-5">
    <div class="col-lg-7 text-center">
        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white mb-3"
              style="width:72px;height:72px"><i class="bi bi-mortarboard-fill fs-2"></i></span>
        <h1 class="h2 fw-semibold">Hệ thống thi trực tuyến</h1>
        <p class="text-muted">Tổ chức lịch thi, làm bài và tra cứu kết quả thi trực tuyến.</p>

        @if (!daDangNhap)
        {
            <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
            </a>
        }
        else if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Teacher))
        {
            <a asp-area="Admin" asp-controller="@(User.IsInRole(SD.Role_Admin) ? "Khoa" : "HocPhan")" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-speedometer2"></i> Vào trang quản trị
            </a>
        }
    </div>
</div>
</div>
