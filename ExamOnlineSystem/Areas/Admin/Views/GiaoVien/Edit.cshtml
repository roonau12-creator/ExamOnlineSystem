@model ExamOnlineSystem.Models.ViewModels.GiaoVienEditVM
@{
    ViewData["Title"] = "Sửa giảng viên";
}
<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Sửa giảng viên</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <partial name="_GiaoVienForm" model="Model" />

                    <h6 class="text-uppercase text-muted small fw-bold mb-3">Tài khoản đăng nhập</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <label class="form-label">Tên đăng nhập</label>
                            <input class="form-control" value="(dùng email ở trên)" disabled />
                            <div class="form-text">Đổi email sẽ đăng xuất giảng viên khỏi các phiên đang đăng nhập.</div>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="MatKhauMoi" class="form-label"></label>
                            <input asp-for="MatKhauMoi" class="form-control" autocomplete="new-password" />
                            <div class="form-text">Để trống nếu không đổi mật khẩu.</div>
                            <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Lưu
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
