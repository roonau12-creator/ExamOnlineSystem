@using ExamOnlineSystem.Models.ViewModels
@model LichThiFormVM
@{
    ViewData["Title"] = "Tạo lịch thi";
    var coDe = (ViewData["DeThiList"] as List<DeThiListItemVM> ?? new()).Count > 0;
}

<form asp-action="Create" method="post" id="frmLichThi">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 class="text-black-50 mb-0"><i class="bi bi-calendar-plus"></i> Tạo lịch thi</h3>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" @(coDe ? "" : "disabled")><i class="bi bi-check-circle"></i> Tạo lịch thi</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Hủy</a>
        </div>
    </div>

    <partial name="_LichThiForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lichthi-form.js" asp-append-version="true"></script>
}
