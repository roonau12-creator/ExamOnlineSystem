@model List<HocPhan>
@{
    ViewData["Title"] = "Quản lý danh sách học phần";
}
<div class="text-center text-black-50">
    <h3>Quản lý danh sách học phần</h3>
</div>
<div class="text-end mb-3">
    <a asp-action="Import" class="btn btn-outline-success"><i class="bi bi-file-spreadsheet"></i>Nhập từ Excel</a>
    <a asp-action="Create" class="btn btn-outline-danger"><i class="bi bi-plus-circle"></i>Thêm học phần</a>
</div>
<table id="tblHocPhan" class="table table-bordered table-hover w-100">
    <thead>
        <tr>
            <th class="bg-primary text-white-50">Mã học phần</th>
            <th class="bg-primary text-white-50">Tên học phần</th>
            <th class="bg-primary text-white-50">Khoa</th>
            <th class="bg-primary text-white-50">Môn học</th>
            <th class="bg-primary text-white-50">Số tín chỉ</th>
            <th class="bg-primary text-white-50">Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaHocPhan</td>
                <td>@item.TenHocPhan</td>
                <td>@item.Khoa?.TenKhoa</td>
                <td>@item.MonHoc?.TenMonHoc</td>
                <td>@item.SoTinChi</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info"><i class="bi bi-pencil-square"></i>Sửa</a>
                    <button type="button" class="btn btn-success btn-delete"
                            data-url="@Url.Action("Delete", new { id = item.Id })"
                            data-name="@item.TenHocPhan">
                        <i class="bi bi-trash3"></i>Xóa
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<form id="deleteForm" method="post">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/hocphan.js" asp-append-version="true"></script>
}
