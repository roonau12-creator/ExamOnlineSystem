@model ExamOnlineSystem.Models.ViewModels.LopDetailVM
@{
    ViewData["Title"] = "Chi tiết lớp " + Model.Lop.MaLop;
    var lop = Model.Lop;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="text-black-50 mb-0">Chi tiết lớp</h3>
    <div class="d-flex gap-2">
        <a asp-action="PhanSinhVien" asp-route-id="@Model.Lop.Id" class="btn btn-outline-success"><i class="bi bi-people"></i> Phân sinh viên</a>
        <a asp-action="Edit" asp-route-id="@Model.Lop.Id" class="btn btn-primary"><i class="bi bi-pencil-square"></i> Sửa</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-people"></i> @lop.TenLop</h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã lớp</dt>
            <dd class="col-sm-9">@lop.MaLop</dd>

            <dt class="col-sm-3">Tên lớp</dt>
            <dd class="col-sm-9">@lop.TenLop</dd>

            <dt class="col-sm-3">Khoa</dt>
            <dd class="col-sm-9">@(lop.Khoa?.TenKhoa ?? "—")</dd>

            <dt class="col-sm-3">Sĩ số</dt>
            <dd class="col-sm-9 mb-0">@Model.SinhViens.Count sinh viên</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Danh sách sinh viên</h5>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="PhanSinhVien" asp-route-id="@lop.Id" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-people"></i> Phân sinh viên vào lớp
                </a>
                <a asp-controller="SinhVien" asp-action="Create" asp-route-lopId="@lop.Id" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-person-plus"></i> Thêm sinh viên mới
                </a>
                <a asp-controller="SinhVien" asp-action="Index" asp-route-lop="@lop.MaLop" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-box-arrow-up-right"></i> Mở trong trang Sinh viên
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (Model.SinhViens.Count == 0)
        {
            <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Lớp chưa có sinh viên nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="bg-primary text-white-50 text-center">STT</th>
                            <th class="bg-primary text-white-50">Mã sinh viên</th>
                            <th class="bg-primary text-white-50">Họ tên</th>
                            <th class="bg-primary text-white-50">Ngày sinh</th>
                            <th class="bg-primary text-white-50">Giới tính</th>
                            <th class="bg-primary text-white-50">Email</th>
                            <th class="bg-primary text-white-50">Số điện thoại</th>
                            <th class="bg-primary text-white-50"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.SinhViens.Count; i++)
                        {
                            var sv = Model.SinhViens[i];
                            <tr>
                                <td class="text-center">@(i + 1)</td>
                                <td>@sv.MaSinhVien</td>
                                <td>@sv.HoTen</td>
                                <td>@sv.NgaySinh.ToString("dd/MM/yyyy")</td>
                                @* GioiTinh: true = Nam, false = Nữ *@
                                <td>@(sv.GioiTinh ? "Nam" : "Nữ")</td>
                                <td>@sv.Email</td>
                                <td>@sv.SoDienThoai</td>
                                <td class="text-center text-nowrap">
                                    <a asp-controller="SinhVien" asp-action="Details" asp-route-id="@sv.Id" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>
                                    <a asp-controller="SinhVien" asp-action="Edit" asp-route-id="@sv.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete-sv"
                                            data-url="@Url.Action("DeleteSinhVien", "SinhVien", new { id = sv.Id })"
                                            data-name="@sv.MaSinhVien – @sv.HoTen">
                                        <i class="bi bi-trash3"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<form id="deleteForm" method="post">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        // Xóa sinh viên khỏi hệ thống (kèm tài khoản), rồi tải lại trang để cập nhật sĩ số
        $(document).on("click", ".btn-delete-sv", function () {
            var btn = this;
            Swal.fire({
                title: "Bạn có chắc chắn?",
                text: "Sinh viên \"" + btn.dataset.name + "\" và tài khoản đăng nhập của sinh viên sẽ bị xóa, không thể hoàn tác!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Xóa",
                cancelButtonText: "Hủy",
                reverseButtons: true
            }).then(function (result) {
                if (!result.isConfirmed) {
                    return;
                }
                $.ajax({
                    url: btn.dataset.url,
                    type: "DELETE",
                    headers: { "RequestVerificationToken": $("#deleteForm input[name='__RequestVerificationToken']").val() }
                }).done(function (res) {
                    if (res.success) {
                        toastr.success(res.message);
                        setTimeout(function () { location.reload(); }, 800);
                    } else {
                        toastr.error(res.message);
                    }
                }).fail(function () {
                    toastr.error("Có lỗi xảy ra khi xóa sinh viên");
                });
            });
        });
    </script>
}
