@model ExamOnlineSystem.Models.ViewModels.KhoaDetailVM
@{
    var khoa = Model.Khoa;
    ViewData["Title"] = "Chi tiết khoa " + khoa.TenKhoa;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="text-black-50 mb-0">Chi tiết khoa</h3>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="ThongKe" asp-action="KhoaChiTiet" asp-route-id="@khoa.Id" class="btn btn-outline-success">
            <i class="bi bi-bar-chart"></i> Thống kê
        </a>
        <a asp-action="Edit" asp-route-id="@khoa.Id" class="btn btn-primary"><i class="bi bi-pencil-square"></i> Sửa</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-building"></i> @khoa.TenKhoa</h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã khoa</dt>
            <dd class="col-sm-9">@khoa.MaKhoa</dd>

            <dt class="col-sm-3">Tên khoa</dt>
            <dd class="col-sm-9">@khoa.TenKhoa</dd>

            <dt class="col-sm-3">Số thứ tự</dt>
            <dd class="col-sm-9 mb-0">@khoa.SoThuTu</dd>
        </dl>
    </div>
</div>

@{
    var tongQuan = new (string Ten, int SoLuong, string Icon)[]
    {
        ("Bộ môn", Model.BoMons.Count, "bi-diagram-3"),
        ("Giảng viên", Model.GiaoViens.Count, "bi-person-badge"),
        ("Môn học", Model.MonHocs.Count, "bi-book"),
        ("Học phần", Model.SoHocPhan, "bi-journal-text"),
        ("Lớp", Model.Lops.Count, "bi-people"),
        ("Sinh viên", Model.SoSinhVien, "bi-mortarboard")
    };
}
<div class="row g-3 mb-4">
    @foreach (var item in tongQuan)
    {
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-primary h-100">
                <div class="card-body py-2">
                    <div class="text-muted small"><i class="bi @item.Icon"></i> @item.Ten</div>
                    <div class="fs-4 fw-bold text-primary">@item.SoLuong</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-bomon" type="button" role="tab">
                    Bộ môn <span class="badge text-bg-secondary">@Model.BoMons.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-lop" type="button" role="tab">
                    Lớp <span class="badge text-bg-secondary">@Model.Lops.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-monhoc" type="button" role="tab">
                    Môn học <span class="badge text-bg-secondary">@Model.MonHocs.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-giaovien" type="button" role="tab">
                    Giảng viên <span class="badge text-bg-secondary">@Model.GiaoViens.Count</span>
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body tab-content">
        @* ===== Bộ môn ===== *@
        <div class="tab-pane fade show active" id="tab-bomon" role="tabpanel">
            <div class="text-end mb-2">
                <a asp-controller="BoMon" asp-action="Index" asp-route-khoaId="@khoa.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-box-arrow-up-right"></i> Mở trong trang Bộ môn</a>
                <a asp-controller="BoMon" asp-action="Create" class="btn btn-sm btn-outline-danger"><i class="bi bi-plus-circle"></i> Thêm bộ môn</a>
            </div>
            @if (Model.BoMons.Count == 0)
            {
                <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Khoa chưa có bộ môn nào.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="bg-primary text-white-50 text-center">STT</th>
                                <th class="bg-primary text-white-50">Mã bộ môn</th>
                                <th class="bg-primary text-white-50">Tên bộ môn</th>
                                <th class="bg-primary text-white-50 text-center">Giảng viên</th>
                                <th class="bg-primary text-white-50 text-center">Môn học</th>
                                <th class="bg-primary text-white-50"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bm in Model.BoMons)
                            {
                                <tr>
                                    <td class="text-center">@bm.SoThuTu</td>
                                    <td>@bm.MaBoMon</td>
                                    <td>@bm.TenBoMon</td>
                                    <td class="text-center">@bm.SoGiaoVien</td>
                                    <td class="text-center">@bm.SoMonHoc</td>
                                    <td class="text-center text-nowrap">
                                        <a asp-controller="BoMon" asp-action="Details" asp-route-id="@bm.Id" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>
                                        <a asp-controller="BoMon" asp-action="Edit" asp-route-id="@bm.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ===== Lớp ===== *@
        <div class="tab-pane fade" id="tab-lop" role="tabpanel">
            <div class="text-end mb-2">
                <a asp-controller="Lop" asp-action="Index" asp-route-khoaId="@khoa.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-box-arrow-up-right"></i> Mở trong trang Lớp</a>
                <a asp-controller="SinhVien" asp-action="Index" asp-route-khoaId="@khoa.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-box-arrow-up-right"></i> Xem sinh viên của khoa</a>
                <a asp-controller="Lop" asp-action="Create" class="btn btn-sm btn-outline-danger"><i class="bi bi-plus-circle"></i> Thêm lớp</a>
            </div>
            @if (Model.Lops.Count == 0)
            {
                <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Khoa chưa có lớp nào.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="bg-primary text-white-50 text-center">STT</th>
                                <th class="bg-primary text-white-50">Mã lớp</th>
                                <th class="bg-primary text-white-50">Tên lớp</th>
                                <th class="bg-primary text-white-50 text-center">Sĩ số</th>
                                <th class="bg-primary text-white-50"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Lops.Count; i++)
                            {
                                var lop = Model.Lops[i];
                                <tr>
                                    <td class="text-center">@(i + 1)</td>
                                    <td>@lop.MaLop</td>
                                    <td>@lop.TenLop</td>
                                    <td class="text-center">@lop.SiSo</td>
                                    <td class="text-center text-nowrap">
                                        <a asp-controller="Lop" asp-action="Details" asp-route-id="@lop.Id" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ===== Môn học ===== *@
        <div class="tab-pane fade" id="tab-monhoc" role="tabpanel">
            <div class="text-end mb-2">
                <a asp-controller="MonHoc" asp-action="Create" class="btn btn-sm btn-outline-danger"><i class="bi bi-plus-circle"></i> Thêm môn học</a>
            </div>
            @if (Model.MonHocs.Count == 0)
            {
                <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Khoa chưa có môn học nào.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="bg-primary text-white-50">Mã môn học</th>
                                <th class="bg-primary text-white-50">Tên môn học</th>
                                <th class="bg-primary text-white-50">Bộ môn</th>
                                <th class="bg-primary text-white-50">Hình thức thi</th>
                                <th class="bg-primary text-white-50 text-center">Thời gian</th>
                                <th class="bg-primary text-white-50">Trạng thái</th>
                                <th class="bg-primary text-white-50"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mh in Model.MonHocs)
                            {
                                <tr>
                                    <td>@mh.MaMonHoc</td>
                                    <td>@mh.TenMonHoc</td>
                                    <td>@mh.TenBoMon</td>
                                    <td>@mh.HinhThucThi</td>
                                    <td class="text-center text-nowrap">@mh.ThoiGianThi phút</td>
                                    <td>
                                        <span class="badge @(mh.TrangThai == "Hoạt động" ? "text-bg-success" : "text-bg-secondary")">@mh.TrangThai</span>
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <a asp-controller="MonHoc" asp-action="Edit" asp-route-id="@mh.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ===== Giảng viên ===== *@
        <div class="tab-pane fade" id="tab-giaovien" role="tabpanel">
            <div class="text-end mb-2">
                <a asp-controller="GiaoVien" asp-action="Index" asp-route-khoaId="@khoa.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-box-arrow-up-right"></i> Mở trong trang Giảng viên</a>
                <a asp-controller="GiaoVien" asp-action="Create" class="btn btn-sm btn-outline-danger"><i class="bi bi-person-plus"></i> Thêm giảng viên</a>
            </div>
            @if (Model.GiaoViens.Count == 0)
            {
                <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Khoa chưa có giảng viên nào.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="bg-primary text-white-50 text-center">STT</th>
                                <th class="bg-primary text-white-50">Mã giảng viên</th>
                                <th class="bg-primary text-white-50">Họ tên</th>
                                <th class="bg-primary text-white-50">Bộ môn</th>
                                <th class="bg-primary text-white-50">Email</th>
                                <th class="bg-primary text-white-50">Số điện thoại</th>
                                <th class="bg-primary text-white-50"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.GiaoViens.Count; i++)
                            {
                                var gv = Model.GiaoViens[i];
                                <tr>
                                    <td class="text-center">@(i + 1)</td>
                                    <td>@gv.MaGiaoVien</td>
                                    <td>@gv.HoTen</td>
                                    <td>@gv.TenBoMon</td>
                                    <td>@gv.Email</td>
                                    <td>@gv.SoDienThoai</td>
                                    <td class="text-center text-nowrap">
                                        <a asp-controller="GiaoVien" asp-action="Details" asp-route-id="@gv.Id" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>
                                        <a asp-controller="GiaoVien" asp-action="Edit" asp-route-id="@gv.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
