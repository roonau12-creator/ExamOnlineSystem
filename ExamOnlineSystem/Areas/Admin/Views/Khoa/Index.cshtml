@model IEnumerable<Khoa>
@{
    ViewData["Title"] = "Quản lý danh sách khoa";
}
<div class="text-center text-black-50">
    <h3>Quản lý danh sách khoa</h3>
</div>
<div class="text-end mb-3">
    <a asp-action="Import" class="btn btn-outline-success"><i class="bi bi-file-spreadsheet"></i>Nhập từ Excel</a>
    <a asp-action="Create" class="btn btn-outline-danger"><i class="bi bi-plus-circle"></i>Thêm khoa</a>
</div>
<table id="tblKhoa" class="table table-bordered table-hover w-100">
    <thead>
        <tr>
            <th class="bg-primary text-white-50">Mã khoa</th>
            <th class="bg-primary text-white-50">Tên khoa</th>
            <th class="bg-primary text-white-50">Số thứ tự</th>
            <th class="bg-primary text-white-50">Chức năng</th>
        </tr>
    </thead>
</table>

<form id="deleteForm" method="post">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/khoa.js" asp-append-version="true"></script>
}
