@model Khoa
@{
    ViewData["Title"] = "Thêm khoa";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Thêm khoa</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="MaKhoa" class="form-label"></label>
                        <input asp-for="MaKhoa" class="form-control" placeholder="Nhập mã khoa" />
                        <span asp-validation-for="MaKhoa" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TenKhoa" class="form-label"></label>
                        <input asp-for="TenKhoa" class="form-control" placeholder="Nhập tên khoa" />
                        <span asp-validation-for="TenKhoa" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SoThuTu" class="form-label"></label>
                        <input asp-for="SoThuTu" type="number" min="1" class="form-control" placeholder="Nhập số thứ tự" />
                        <span asp-validation-for="SoThuTu" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Thêm
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
