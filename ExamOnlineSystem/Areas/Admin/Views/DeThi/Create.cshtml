@using ExamOnlineSystem.Models.ViewModels
@model DeThiFormVM
@{
    ViewData["Title"] = "Thêm đề thi";
}

<form asp-action="Create" method="post" id="frmDeThi">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 class="text-black-50 mb-0"><i class="bi bi-file-earmark-plus"></i> Thêm đề thi</h3>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Lưu đề thi</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Hủy</a>
        </div>
    </div>

    <partial name="_DeThiForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/dethi-form.js" asp-append-version="true"></script>
}
