@using ExamOnlineSystem.Models.ViewModels
@using ExamOnlineSystem.Utility
@model ExamOnlineSystem.Models.ViewModels.ThongKeBoMonChiTietVM
@{
    var b = Model.BoMon;
    ViewData["Title"] = "Thống kê " + b.TenBoMon;
    var mauXl = KetQuaLabel.MauXepLoai(b.XepLoai);

    // Phân bố câu hỏi theo mức độ (CauHoiLabel.TenMucDo: 1 Dễ … 4 Rất khó)
    var theoMucDo = new[]
    {
        (MucDo: 1, SoLuong: b.SoCauHoiDe, Mau: "success"),
        (MucDo: 2, SoLuong: b.SoCauHoiTrungBinh, Mau: "info"),
        (MucDo: 3, SoLuong: b.SoCauHoiKho, Mau: "warning"),
        (MucDo: 4, SoLuong: b.SoCauHoiRatKho, Mau: "danger")
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="text-black-50 mb-0">
        <i class="bi bi-diagram-3"></i> @b.TenBoMon
        <span class="text-muted fs-6">(@b.MaBoMon)</span>
        @if (b.ChuaCoNganHangDe)
        {
            <span class="badge fs-6 align-middle text-bg-secondary" title="Chưa có câu hỏi hay đề thi nào">Chưa có ngân hàng đề</span>
        }
    </h3>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="KhoaChiTiet" asp-route-id="@b.KhoaId" class="btn btn-outline-secondary">
            <i class="bi bi-building"></i> @b.TenKhoa
        </a>
        <a asp-action="BoMon" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại thống kê</a>
    </div>
</div>

@* Thống kê nhanh *@
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card border-primary h-100"><div class="card-body py-2">
            <div class="text-muted small">Giảng viên</div>
            <div class="fs-4 fw-bold text-primary">@b.SoGiaoVien</div>
            <div class="small text-muted">
                @if (b.SoGiaoVienDaKhoa > 0)
                {
                    <span class="text-danger">@b.SoGiaoVienDaKhoa tài khoản đã khóa</span>
                }
                else if (b.SoGiaoVien > 0)
                {
                    <text>TB @b.CauHoiMoiGiaoVien câu hỏi/giảng viên</text>
                }
                else
                {
                    <text>Chưa có giảng viên</text>
                }
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Môn học</div>
            <div class="fs-4 fw-bold text-info">@b.SoMonHoc</div>
            <div class="small text-muted">
                @b.SoMonHocHoatDong đang hoạt động · @b.SoHocPhan học phần · @b.SoLopHocPhan lớp HP
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Ngân hàng đề</div>
            <div class="fs-4 fw-bold text-info">@b.SoCauHoi<span class="fs-6 text-muted"> câu hỏi</span></div>
            <div class="small text-muted">
                @b.SoDeThi đề thi (@b.SoDeThiDaPhatHanh đã phát hành) · @b.SoDanhMucCauHoi danh mục
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-@mauXl h-100"><div class="card-body py-2">
            <div class="text-muted small">Kết quả thi (hệ 10)</div>
            <div class="fs-4 fw-bold text-@mauXl">@(b.DiemTrungBinhHe10?.ToString("0.##") ?? "—")</div>
            <div class="small text-muted">
                @b.SoLichThi lịch thi · @b.SoBaiDaNop/@b.SoLuotDuThi bài đã nộp
                @if (b.SoBaiChuaCham > 0)
                {
                    <span class="text-danger">· @b.SoBaiChuaCham chưa chấm</span>
                }
                else if (b.SoBaiCoDiem > 0)
                {
                    <text>· @b.TiLeDat% đạt</text>
                }
            </div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-3">
    @* Câu hỏi theo mức độ *@
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-bar-chart-steps"></i> Câu hỏi theo mức độ</h5>
            </div>
            <div class="card-body">
                @if (b.SoCauHoi == 0)
                {
                    <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Bộ môn chưa có câu hỏi nào.</p>
                }
                else
                {
                    foreach (var (mucDo, soLuong, mau) in theoMucDo)
                    {
                        var tiLe = (int)Math.Round(soLuong * 100.0 / b.SoCauHoi);
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="text-nowrap small" style="width:100px">@CauHoiLabel.TenMucDo(mucDo)</div>
                            <div class="progress flex-grow-1" role="progressbar" aria-valuenow="@tiLe" aria-valuemin="0" aria-valuemax="100" style="height:1.25rem">
                                <div class="progress-bar bg-@mau" style="width:@tiLe%">@(tiLe > 10 ? tiLe + "%" : "")</div>
                            </div>
                            <div class="text-nowrap small text-muted" style="width:60px">@soLuong câu</div>
                        </div>
                    }
                    <hr />
                    <div class="small text-muted">
                        <i class="bi bi-check2-square"></i> @b.SoCauHoiTracNghiem câu trắc nghiệm ·
                        <i class="bi bi-pencil"></i> @b.SoCauHoiTuLuan câu tự luận
                    </div>
                }
            </div>
        </div>
    </div>

    @* Phân bố điểm các bài thi *@
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-bar-chart-line"></i> Phân bố điểm các bài thi (thang 10)</h5>
            </div>
            <div class="card-body">
                @if (b.SoBaiCoDiem == 0)
                {
                    <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Chưa có bài thi nào được chấm điểm.</p>
                }
                else
                {
                    foreach (var p in Model.PhanBo)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="text-nowrap small" style="width:140px">
                                <span class="badge text-bg-@p.Mau">@p.XepLoai</span>
                                <span class="text-muted">@p.Nhan</span>
                            </div>
                            <div class="progress flex-grow-1" role="progressbar" aria-valuenow="@p.TiLe" aria-valuemin="0" aria-valuemax="100" style="height:1.25rem">
                                <div class="progress-bar bg-@p.Mau" style="width:@p.TiLe%">@(p.TiLe > 8 ? p.TiLe + "%" : "")</div>
                            </div>
                            <div class="text-nowrap small text-muted" style="width:70px">@p.SoLuong bài</div>
                        </div>
                    }
                    <hr />
                    <div class="small text-muted">
                        Cao nhất @(b.DiemCaoNhatHe10?.ToString("0.##") ?? "—") ·
                        thấp nhất @(b.DiemThapNhatHe10?.ToString("0.##") ?? "—") ·
                        @b.SoBaiDat/@b.SoBaiCoDiem bài đạt
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Giảng viên của bộ môn *@
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white">
        <h5 class="mb-0">
            <i class="bi bi-person-workspace"></i> Giảng viên của bộ môn (@Model.GiaoViens.Count)
            <span class="small text-muted fw-normal">
                — số câu hỏi / đề thi dưới đây là của riêng giảng viên trên toàn hệ thống,
                có thể thuộc môn học của bộ môn khác
            </span>
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.GiaoViens.Count == 0)
        {
            <p class="text-muted m-3 mb-0"><i class="bi bi-info-circle"></i> Bộ môn chưa có giảng viên nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="bg-primary text-white-50">Mã GV</th>
                            <th class="bg-primary text-white-50">Họ tên</th>
                            <th class="bg-primary text-white-50">Email</th>
                            <th class="bg-primary text-white-50 text-center">Câu hỏi</th>
                            <th class="bg-primary text-white-50 text-center">Đề thi</th>
                            <th class="bg-primary text-white-50 text-center">Lịch thi</th>
                            <th class="bg-primary text-white-50 text-center">Lớp HP</th>
                            <th class="bg-primary text-white-50 text-center">Đăng nhập cuối</th>
                            <th class="bg-primary text-white-50 text-center"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model.GiaoViens)
                        {
                            <tr>
                                <td class="fw-semibold">@g.MaGiaoVien</td>
                                <td>
                                    @g.HoTen
                                    <div class="small text-muted">
                                        @(string.IsNullOrWhiteSpace(g.ChucDanh) ? "Giảng viên" : g.ChucDanh)
                                        @if (!g.DangHoatDong)
                                        {
                                            <span class="badge text-bg-secondary"><i class="bi bi-lock-fill"></i> Đã khóa</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(g.Email))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <a href="mailto:@g.Email">@g.Email</a>
                                    }
                                </td>
                                <td class="text-center fw-semibold">@g.SoCauHoi</td>
                                <td class="text-center">@g.SoDeThi</td>
                                <td class="text-center">@g.SoLichThi</td>
                                <td class="text-center">@g.SoLopHocPhan</td>
                                <td class="text-center text-nowrap">
                                    @(g.LanDangNhapCuoi?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                                </td>
                                <td class="text-center">
                                    <a asp-action="GiaoVienChiTiet" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary" title="Xem thống kê giảng viên">
                                        <i class="bi bi-bar-chart"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Môn học của bộ môn *@
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-journal-bookmark"></i> Môn học của bộ môn (@Model.MonHocs.Count)</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.MonHocs.Count == 0)
        {
            <p class="text-muted m-3 mb-0"><i class="bi bi-info-circle"></i> Bộ môn chưa có môn học nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="bg-primary text-white-50">Mã môn</th>
                            <th class="bg-primary text-white-50">Tên môn học</th>
                            <th class="bg-primary text-white-50 text-center">Trạng thái</th>
                            <th class="bg-primary text-white-50 text-center">Học phần</th>
                            <th class="bg-primary text-white-50 text-center">Danh mục</th>
                            <th class="bg-primary text-white-50 text-center">Câu hỏi</th>
                            <th class="bg-primary text-white-50 text-center">Đề thi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.MonHocs)
                        {
                            <tr>
                                <td class="fw-semibold">@m.MaMonHoc</td>
                                <td>@m.TenMonHoc</td>
                                <td class="text-center">
                                    <span class="badge text-bg-@(m.TrangThai == "Hoạt động" ? "success" : "secondary")">@m.TrangThai</span>
                                </td>
                                <td class="text-center">@m.SoHocPhan</td>
                                <td class="text-center">@m.SoDanhMucCauHoi</td>
                                <td class="text-center fw-semibold">@m.SoCauHoi</td>
                                <td class="text-center">
                                    @m.SoDeThi
                                    @if (m.SoDeThi > 0)
                                    {
                                        <div class="small text-muted">@m.SoDeThiDaPhatHanh đã phát hành</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
