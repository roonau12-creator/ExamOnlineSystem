@using ExamOnlineSystem.Models.ViewModels
@model ExamOnlineSystem.Models.ViewModels.ThongKeGiaoVienTongQuanVM
@{
    ViewData["Title"] = "Thống kê giảng viên";

    // Số giảng viên theo từng mức độ hoạt động
    var theoMucDo = ThongKeGiaoVienLabel.CacMucDo
        .Select(m => (MucDo: m, SoLuong: Model.GiaoViens.Count(g => g.MucDoHoatDong == m)))
        .ToList();

    var topCauHoi = Model.GiaoViens.Where(g => g.SoCauHoi > 0)
        .OrderByDescending(g => g.SoCauHoi).Take(5).ToList();
    var topDeThi = Model.GiaoViens.Where(g => g.SoDeThi > 0)
        .OrderByDescending(g => g.SoDeThi).ThenByDescending(g => g.SoLichThi).Take(5).ToList();
    var maxCauHoi = topCauHoi.Count == 0 ? 1 : topCauHoi.Max(g => g.SoCauHoi);
    var maxDeThi = topDeThi.Count == 0 ? 1 : topDeThi.Max(g => g.SoDeThi);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="text-black-50 mb-0"><i class="bi bi-graph-up-arrow"></i> Thống kê giảng viên</h3>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="XuatExcelGiaoVien" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> Xuất Excel
        </a>
        <a asp-controller="GiaoVien" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-person-workspace"></i> Danh sách giảng viên
        </a>
    </div>
</div>

@if (Model.TongGiaoVien == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Chưa có giảng viên nào trong hệ thống.
        <a asp-controller="User" asp-action="Create">Tạo tài khoản giảng viên</a> để bắt đầu.
    </div>
    return;
}

@* Thống kê nhanh *@
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-primary h-100"><div class="card-body py-2">
            <div class="text-muted small">Giảng viên</div>
            <div class="fs-4 fw-bold text-primary">@Model.TongGiaoVien</div>
            <div class="small text-muted">
                @Model.SoDangHoatDong đang hoạt động
                @if (Model.SoDaKhoa > 0)
                {
                    <span class="text-danger">· @Model.SoDaKhoa đã khóa</span>
                }
            </div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Câu hỏi đã soạn</div>
            <div class="fs-4 fw-bold text-info">@Model.TongCauHoi</div>
            <div class="small text-muted">TB @Model.TrungBinhCauHoi câu / giảng viên</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-success h-100"><div class="card-body py-2">
            <div class="text-muted small">Đề thi đã tạo</div>
            <div class="fs-4 fw-bold text-success">@Model.TongDeThi</div>
            <div class="small text-muted">@Model.TongDeThiDaPhatHanh đã phát hành · TB @Model.TrungBinhDeThi đề / GV</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-warning h-100"><div class="card-body py-2">
            <div class="text-muted small">Lịch thi đã tổ chức</div>
            <div class="fs-4 fw-bold text-warning">@Model.TongLichThi</div>
            <div class="small text-muted">
                @Model.TongBaiDaNop/@Model.TongLuotDuThi bài đã nộp
                @if (Model.TongBaiChuaCham > 0)
                {
                    <span class="text-danger">· @Model.TongBaiChuaCham chưa chấm</span>
                }
            </div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-3">
    @* Mức độ hoạt động *@
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-activity"></i> Mức độ hoạt động</h5>
            </div>
            <div class="card-body">
                @foreach (var (mucDo, soLuong) in theoMucDo)
                {
                    var mau = ThongKeGiaoVienLabel.MauMucDo(mucDo);
                    var tiLe = (int)Math.Round(soLuong * 100.0 / Model.TongGiaoVien);
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="text-nowrap small" style="width:110px"><span class="badge text-bg-@mau">@mucDo</span></div>
                        <div class="progress flex-grow-1" role="progressbar" aria-valuenow="@tiLe" aria-valuemin="0" aria-valuemax="100" style="height:1.25rem">
                            <div class="progress-bar bg-@mau" style="width:@tiLe%">@(tiLe > 10 ? tiLe + "%" : "")</div>
                        </div>
                        <div class="text-nowrap small text-muted" style="width:50px">@soLuong GV</div>
                    </div>
                }
                <hr />
                <div class="small text-muted">
                    <i class="bi bi-exclamation-circle"></i> @Model.SoChuaCoHoatDong giảng viên chưa có câu hỏi / đề thi / lịch thi nào.
                    @if (Model.SoChuaDangNhap > 0)
                    {
                        <br />
                        <i class="bi bi-person-dash"></i>

                        @:@Model.SoChuaDangNhap giảng viên chưa đăng nhập lần nào.
                    }
                </div>
            </div>
        </div>
    </div>

    @* Top câu hỏi *@
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-question-circle"></i> Soạn nhiều câu hỏi nhất</h5>
            </div>
            <div class="card-body">
                @if (topCauHoi.Count == 0)
                {
                    <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Chưa có giảng viên nào soạn câu hỏi.</p>
                }
                else
                {
                    foreach (var g in topCauHoi)
                    {
                        var tiLe = (int)Math.Round(g.SoCauHoi * 100.0 / maxCauHoi);
                        <div class="mb-2">
                            <div class="d-flex justify-content-between small">
                                <a asp-action="GiaoVienChiTiet" asp-route-id="@g.Id" class="text-decoration-none">@g.HoTen</a>
                                <span class="fw-semibold">@g.SoCauHoi</span>
                            </div>
                            <div class="progress" role="progressbar" aria-valuenow="@tiLe" aria-valuemin="0" aria-valuemax="100" style="height:.6rem">
                                <div class="progress-bar bg-info" style="width:@tiLe%"></div>
                            </div>
                            <div class="small text-muted">@g.SoCauHoiTracNghiem trắc nghiệm · @g.SoCauHoiTuLuan tự luận</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* Top đề thi *@
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-file-earmark-text"></i> Tạo nhiều đề thi nhất</h5>
            </div>
            <div class="card-body">
                @if (topDeThi.Count == 0)
                {
                    <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Chưa có giảng viên nào tạo đề thi.</p>
                }
                else
                {
                    foreach (var g in topDeThi)
                    {
                        var tiLe = (int)Math.Round(g.SoDeThi * 100.0 / maxDeThi);
                        <div class="mb-2">
                            <div class="d-flex justify-content-between small">
                                <a asp-action="GiaoVienChiTiet" asp-route-id="@g.Id" class="text-decoration-none">@g.HoTen</a>
                                <span class="fw-semibold">@g.SoDeThi</span>
                            </div>
                            <div class="progress" role="progressbar" aria-valuenow="@tiLe" aria-valuemin="0" aria-valuemax="100" style="height:.6rem">
                                <div class="progress-bar bg-success" style="width:@tiLe%"></div>
                            </div>
                            <div class="small text-muted">@g.SoDeThiDaPhatHanh đã phát hành · @g.SoLichThi lịch thi</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@* Gộp theo khoa / bộ môn *@
<div class="row g-3 mb-3">
    @foreach (var (tieuDe, icon, nhom, coCha) in new[]
    {
        ("Theo khoa", "bi-building", Model.TheoKhoa, false),
        ("Theo bộ môn", "bi-diagram-3", Model.TheoBoMon, true)
    })
    {
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi @icon"></i> @tieuDe (@nhom.Count)</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="bg-primary text-white-50">@(coCha ? "Bộ môn" : "Khoa")</th>
                                    <th class="bg-primary text-white-50 text-center">GV</th>
                                    <th class="bg-primary text-white-50 text-center">Câu hỏi</th>
                                    <th class="bg-primary text-white-50 text-center">Đề thi</th>
                                    <th class="bg-primary text-white-50 text-center">Lịch thi</th>
                                    <th class="bg-primary text-white-50 text-center">LHP</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var n in nhom)
                                {
                                    <tr>
                                        <td>
                                            @n.Ten
                                            @if (coCha && !string.IsNullOrWhiteSpace(n.TenCha))
                                            {
                                                <div class="small text-muted">@n.TenCha</div>
                                            }
                                        </td>
                                        <td class="text-center">@n.SoGiaoVien</td>
                                        <td class="text-center">@n.SoCauHoi</td>
                                        <td class="text-center">@n.SoDeThi</td>
                                        <td class="text-center">@n.SoLichThi</td>
                                        <td class="text-center">@n.SoLopHocPhan</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* Bảng thống kê từng giảng viên *@
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0"><i class="bi bi-table"></i> Chi tiết theo giảng viên (@Model.TongGiaoVien)</h5>
        <div class="d-flex flex-wrap gap-2">
            <select id="locKhoa" class="form-select form-select-sm w-auto">
                <option value="">-- Tất cả khoa --</option>
                @foreach (var k in Model.TheoKhoa.Select(x => x.Ten).OrderBy(x => x))
                {
                    <option value="@k">@k</option>
                }
            </select>
            <select id="locBoMon" class="form-select form-select-sm w-auto">
                <option value="">-- Tất cả bộ môn --</option>
                @foreach (var b in Model.TheoBoMon.Select(x => x.Ten).OrderBy(x => x))
                {
                    <option value="@b">@b</option>
                }
            </select>
            <select id="locMucDo" class="form-select form-select-sm w-auto">
                <option value="">-- Tất cả mức độ --</option>
                @foreach (var m in ThongKeGiaoVienLabel.CacMucDo)
                {
                    <option value="@m">@m</option>
                }
            </select>
        </div>
    </div>
    <div class="card-body">
        <table id="tblThongKeGiaoVien" class="table table-bordered table-hover align-middle w-100">
            <thead>
                <tr>
                    <th class="bg-primary text-white-50">Mã GV</th>
                    <th class="bg-primary text-white-50">Họ tên</th>
                    <th class="bg-primary text-white-50">Bộ môn</th>
                    <th class="bg-primary text-white-50">Khoa</th>
                    <th class="bg-primary text-white-50 text-center">Câu hỏi</th>
                    <th class="bg-primary text-white-50 text-center">Đề thi</th>
                    <th class="bg-primary text-white-50 text-center">Lịch thi</th>
                    <th class="bg-primary text-white-50 text-center">Lớp HP</th>
                    <th class="bg-primary text-white-50 text-center">Lượt dự thi</th>
                    <th class="bg-primary text-white-50 text-center">Điểm TB</th>
                    <th class="bg-primary text-white-50 text-center">Mức độ</th>
                    <th class="bg-primary text-white-50 text-center">Đăng nhập cuối</th>
                    <th class="bg-primary text-white-50 text-center"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model.GiaoViens)
                {
                    var mauMucDo = ThongKeGiaoVienLabel.MauMucDo(g.MucDoHoatDong);
                    <tr data-khoa="@g.TenKhoa" data-bo-mon="@g.TenBoMon" data-muc-do="@g.MucDoHoatDong">
                        <td class="fw-semibold">@g.MaGiaoVien</td>
                        <td>
                            <a asp-action="GiaoVienChiTiet" asp-route-id="@g.Id" class="text-decoration-none fw-semibold">@g.HoTen</a>
                            <div class="small text-muted">
                                @(string.IsNullOrWhiteSpace(g.ChucDanh) ? "Giảng viên" : g.ChucDanh)
                                @if (!g.DangHoatDong)
                                {
                                    <span class="badge text-bg-secondary"><i class="bi bi-lock-fill"></i> Đã khóa</span>
                                }
                            </div>
                        </td>
                        <td>@g.TenBoMon</td>
                        <td>@g.TenKhoa</td>
                        <td class="text-center">
                            <span class="fw-semibold">@g.SoCauHoi</span>
                            @if (g.SoCauHoi > 0)
                            {
                                <div class="small text-muted">@g.SoCauHoiTracNghiem TN / @g.SoCauHoiTuLuan TL</div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="fw-semibold">@g.SoDeThi</span>
                            @if (g.SoDeThi > 0)
                            {
                                <div class="small text-muted">@g.SoDeThiDaPhatHanh đã phát hành</div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="fw-semibold">@g.SoLichThi</span>
                            @if (g.SoLichThiDangDienRa > 0)
                            {
                                <div class="small text-success">@g.SoLichThiDangDienRa đang diễn ra</div>
                            }
                            else if (g.SoLichThiSapDienRa > 0)
                            {
                                <div class="small text-info">@g.SoLichThiSapDienRa sắp diễn ra</div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="fw-semibold">@g.SoLopHocPhan</span>
                            @if (g.SoLopHocPhan > 0)
                            {
                                <div class="small text-muted">@g.SoLopHocPhanPhuTrach phụ trách</div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="fw-semibold">@g.SoLuotDuThi</span>
                            @if (g.SoLuotDuThi > 0)
                            {
                                <div class="small text-muted">@g.SoBaiDaNop đã nộp (@g.TiLeNop%)</div>
                            }
                        </td>
                        <td class="text-center" data-order="@(g.DiemTrungBinhHe10?.ToString("0.00") ?? "-1")">
                            @if (g.DiemTrungBinhHe10.HasValue)
                            {
                                <span class="badge text-bg-@KetQuaLabel.MauXepLoai(KetQuaLabel.XepLoai(g.DiemTrungBinhHe10))">
                                    @g.DiemTrungBinhHe10.Value.ToString("0.##")
                                </span>
                                <div class="small text-muted">@g.SoBaiDat/@g.SoBaiCoDiem đạt</div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center"><span class="badge text-bg-@mauMucDo">@g.MucDoHoatDong</span></td>
                        <td class="text-center text-nowrap" data-order="@(g.LanDangNhapCuoi?.ToString("yyyyMMddHHmm") ?? "")">
                            @(g.LanDangNhapCuoi?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                        </td>
                        <td class="text-center">
                            <a asp-action="GiaoVienChiTiet" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary" title="Xem thống kê chi tiết">
                                <i class="bi bi-bar-chart"></i> Chi tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/thongke-giaovien.js" asp-append-version="true"></script>
}
