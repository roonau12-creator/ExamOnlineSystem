@using ExamOnlineSystem.Models.ViewModels
@using ExamOnlineSystem.Utility
@model ExamOnlineSystem.Models.ViewModels.ThongKeSinhVienChiTietVM
@{
    var s = Model.SinhVien;
    ViewData["Title"] = "Thống kê sinh viên " + s.HoTen;
    var mauXl = KetQuaLabel.MauXepLoai(s.XepLoai);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="text-black-50 mb-0">
        <i class="bi bi-bar-chart"></i> Thống kê sinh viên
        <span class="badge fs-6 align-middle text-bg-@mauXl">@s.XepLoai</span>
    </h3>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Lop" asp-action="Details" asp-route-id="@s.LopId" class="btn btn-outline-secondary">
            <i class="bi bi-people"></i> Xem lớp @s.MaLop
        </a>
        <a asp-action="SinhVien" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại thống kê</a>
    </div>
</div>

@* Thông tin sinh viên *@
<div class="card shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="row g-3">
            <div class="col-lg-5">
                <h5 class="mb-1">
                    @s.HoTen <span class="text-muted fs-6">(@s.MaSinhVien)</span>
                    @if (!s.DangHoatDong)
                    {
                        <span class="badge text-bg-secondary"><i class="bi bi-lock-fill"></i> Đã khóa</span>
                    }
                </h5>
                <div class="small text-muted">
                    <i class="bi bi-person"></i> @(s.GioiTinh ? "Nam" : "Nữ") ·
                    @s.NgaySinh.ToString("dd/MM/yyyy") (@s.Tuoi tuổi)
                </div>
                <div class="small text-muted"><i class="bi bi-people"></i> @s.MaLop – @s.TenLop · @s.TenKhoa</div>
            </div>
            <div class="col-lg-4">
                @if (!string.IsNullOrWhiteSpace(s.Email))
                {
                    <div class="small"><i class="bi bi-envelope"></i> <a href="mailto:@s.Email">@s.Email</a></div>
                }
                @if (!string.IsNullOrWhiteSpace(s.SoDienThoai))
                {
                    <div class="small text-muted"><i class="bi bi-telephone"></i> @s.SoDienThoai</div>
                }
                <div class="small text-muted"><i class="bi bi-collection"></i> @s.SoLopHocPhan lớp học phần</div>
            </div>
            <div class="col-lg-3">
                <div class="small text-muted">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập cuối:
                    @(s.LanDangNhapCuoi?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "chưa đăng nhập")
                </div>
                <div class="small text-muted">
                    <i class="bi bi-calendar-plus"></i> Tạo tài khoản: @s.NgayTaoTaiKhoan.ToLocalTime().ToString("dd/MM/yyyy")
                </div>
            </div>
        </div>
    </div>
</div>

@* Thống kê nhanh *@
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card border-primary h-100"><div class="card-body py-2">
            <div class="text-muted small">Lịch thi được giao</div>
            <div class="fs-4 fw-bold text-primary">@s.SoLichThi</div>
            <div class="small text-muted">
                @s.SoChuaThi chưa thi · @s.SoDangLamBai đang làm bài
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-success h-100"><div class="card-body py-2">
            <div class="text-muted small">Bài đã nộp</div>
            <div class="fs-4 fw-bold text-success">@s.SoBaiDaNop<span class="fs-6 text-muted">/@s.SoLichThi</span></div>
            <div class="small text-muted">
                @if (s.SoLanThi > 0)
                {
                    <text>@s.SoLanThi lượt làm bài</text>
                }
                else
                {
                    <text>@s.TiLeNop% lịch thi đã nộp</text>
                }
                @if (s.SoBaiChuaCham > 0)
                {
                    <span class="text-danger">· @s.SoBaiChuaCham chưa chấm</span>
                }
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Điểm trung bình (hệ 10)</div>
            <div class="fs-4 fw-bold text-info">@(s.DiemTrungBinhHe10?.ToString("0.##") ?? "—")</div>
            <div class="small text-muted">
                Cao nhất @(s.DiemCaoNhatHe10?.ToString("0.##") ?? "—") ·
                thấp nhất @(s.DiemThapNhatHe10?.ToString("0.##") ?? "—")
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-warning h-100"><div class="card-body py-2">
            <div class="text-muted small">Bài đạt (≥ 5)</div>
            <div class="fs-4 fw-bold text-warning">@s.SoBaiDat<span class="fs-6 text-muted">/@s.SoBaiCoDiem</span></div>
            <div class="small text-muted">@(s.SoBaiCoDiem == 0 ? "chưa có bài được chấm" : s.TiLeDat + "% đạt")</div>
        </div></div>
    </div>
</div>

@* Phân bố điểm các bài thi *@
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-bar-chart-line"></i> Phân bố điểm các bài thi (thang 10)</h5>
    </div>
    <div class="card-body">
        @if (s.SoBaiCoDiem == 0)
        {
            <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Sinh viên chưa có bài thi nào được chấm điểm.</p>
        }
        else
        {
            foreach (var k in Model.PhanBo)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="text-nowrap small" style="width:150px">
                        <span class="badge text-bg-@k.Mau">@k.XepLoai</span>
                        <span class="text-muted">@k.Nhan</span>
                    </div>
                    <div class="progress flex-grow-1" role="progressbar" aria-valuenow="@k.TiLe" aria-valuemin="0" aria-valuemax="100" style="height:1.25rem">
                        <div class="progress-bar bg-@k.Mau" style="width:@k.TiLe%">@(k.TiLe > 8 ? k.TiLe + "%" : "")</div>
                    </div>
                    <div class="text-nowrap small text-muted" style="width:80px">@k.SoLuong bài (@k.TiLe%)</div>
                </div>
            }
        }
    </div>
</div>

@* Kết quả từng lịch thi *@
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-calendar-event"></i> Kết quả từng lịch thi (@Model.LichThis.Count)</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.LichThis.Count == 0)
        {
            <p class="text-muted m-3 mb-0"><i class="bi bi-info-circle"></i> Sinh viên chưa được giao lịch thi nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="bg-primary text-white-50">Lịch thi</th>
                            <th class="bg-primary text-white-50">Môn học</th>
                            <th class="bg-primary text-white-50">Khung giờ thi</th>
                            <th class="bg-primary text-white-50 text-center">Trạng thái</th>
                            <th class="bg-primary text-white-50 text-center">Lần thi</th>
                            <th class="bg-primary text-white-50 text-center">Làm bài</th>
                            <th class="bg-primary text-white-50 text-center">Điểm</th>
                            <th class="bg-primary text-white-50 text-center">Hệ 10</th>
                            <th class="bg-primary text-white-50 text-center">Xếp loại</th>
                            <th class="bg-primary text-white-50 text-center">Bài làm</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.LichThis)
                        {
                            var batDau = l.ThoiGianBatDau.ToLocalTime();
                            var ketThuc = l.ThoiGianKetThuc.ToLocalTime();
                            var mauXlBai = KetQuaLabel.MauXepLoai(l.XepLoai);
                            <tr>
                                <td>
                                    <a asp-controller="KetQuaThi" asp-action="Details" asp-route-id="@l.LichThiId" class="text-decoration-none fw-semibold">@l.TenLichThi</a>
                                    <div class="small text-muted">Đề @l.MaDeThi · @l.TenGiaoVien</div>
                                </td>
                                <td>@l.TenMonHoc</td>
                                <td class="text-nowrap">
                                    @batDau.ToString("dd/MM/yyyy HH:mm")
                                    – @(batDau.Date == ketThuc.Date ? ketThuc.ToString("HH:mm") : ketThuc.ToString("dd/MM HH:mm"))
                                    <div class="small text-muted">@l.TrangThaiLich</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge text-bg-@KetQuaLabel.MauTrangThai(l.TrangThai)">@KetQuaLabel.TenTrangThai(l.TrangThai)</span>
                                </td>
                                <td class="text-center">@(l.SoLanThi == 0 ? "—" : l.SoLanThi.ToString())</td>
                                <td class="text-center text-nowrap">
                                    @if (l.SoPhutLamBai.HasValue)
                                    {
                                        @($"{l.SoPhutLamBai.Value} phút")
                                        <div class="small text-muted">nộp @l.NopBai!.Value.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center fw-semibold">
                                    @if (l.Diem.HasValue)
                                    {
                                        @l.Diem.Value.ToString("0.##")

                                        <span class="text-muted small">/@l.TongDiem.ToString("0.##")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (l.DiemHe10.HasValue)
                                    {
                                        <span class="badge text-bg-@mauXlBai">@l.DiemHe10.Value.ToString("0.##")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center"><span class="text-@mauXlBai">@l.XepLoai</span></td>
                                <td class="text-center">
                                    @if (l.LanThiId.HasValue)
                                    {
                                        <a asp-controller="KetQuaThi" asp-action="BaiLam" asp-route-id="@l.LanThiId" class="btn btn-sm btn-outline-primary" title="Xem bài làm">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Lớp học phần đã đăng ký *@
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-collection"></i> Lớp học phần đã đăng ký (@Model.LopHocPhans.Count)</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.LopHocPhans.Count == 0)
        {
            <p class="text-muted m-3 mb-0"><i class="bi bi-info-circle"></i> Sinh viên chưa đăng ký lớp học phần nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="bg-primary text-white-50">Mã LHP</th>
                            <th class="bg-primary text-white-50">Tên lớp học phần</th>
                            <th class="bg-primary text-white-50">Môn học</th>
                            <th class="bg-primary text-white-50">Năm học</th>
                            <th class="bg-primary text-white-50 text-center">Học kỳ</th>
                            <th class="bg-primary text-white-50">Giảng viên phụ trách</th>
                            <th class="bg-primary text-white-50 text-center">Ngày đăng ký</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.LopHocPhans)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a asp-controller="LopHocPhan" asp-action="Details" asp-route-id="@l.Id">@l.MaLopHocPhan</a>
                                </td>
                                <td>@l.TenLopHocPhan</td>
                                <td>@l.TenMonHoc</td>
                                <td>@l.TenNamHoc</td>
                                <td class="text-center">@LopHocPhanLabel.TenHocKy(l.HocKy)</td>
                                <td>@(string.IsNullOrWhiteSpace(l.GiaoVienPhuTrach) ? "—" : l.GiaoVienPhuTrach)</td>
                                <td class="text-center text-nowrap">@l.NgayDangKy.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
