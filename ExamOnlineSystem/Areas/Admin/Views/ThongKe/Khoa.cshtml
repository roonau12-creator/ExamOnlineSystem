@using ExamOnlineSystem.Models.ViewModels
@model ExamOnlineSystem.Models.ViewModels.ThongKeKhoaTongQuanVM
@{
    ViewData["Title"] = "Thống kê khoa";

    var maxSinhVien = Model.Khoas.Count == 0 ? 1 : Math.Max(Model.Khoas.Max(k => k.SoSinhVien), 1);
    var maxCauHoi = Model.Khoas.Count == 0 ? 1 : Math.Max(Model.Khoas.Max(k => k.SoCauHoi), 1);
    var topSinhVien = Model.Khoas.Where(k => k.SoSinhVien > 0).OrderByDescending(k => k.SoSinhVien).Take(5).ToList();
    var topCauHoi = Model.Khoas.Where(k => k.SoCauHoi > 0).OrderByDescending(k => k.SoCauHoi).Take(5).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="text-black-50 mb-0"><i class="bi bi-building"></i> Thống kê khoa</h3>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="XuatExcelKhoa" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> Xuất Excel
        </a>
        <a asp-action="GiaoVien" class="btn btn-outline-secondary">
            <i class="bi bi-graph-up-arrow"></i> Giảng viên
        </a>
        <a asp-action="SinhVien" class="btn btn-outline-secondary">
            <i class="bi bi-mortarboard"></i> Sinh viên
        </a>
        <a asp-controller="Khoa" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-list-ul"></i> Danh sách khoa
        </a>
    </div>
</div>

@if (Model.TongKhoa == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Chưa có khoa nào trong hệ thống.
        <a asp-controller="Khoa" asp-action="Create">Thêm khoa</a> để bắt đầu.
    </div>
    return;
}

<div class="alert alert-light border small py-2">
    <i class="bi bi-info-circle"></i>
    Câu hỏi và đề thi được quy về khoa <strong>theo môn học</strong> (không theo người soạn);
    lịch thi tính theo <strong>giảng viên phụ trách</strong>; kết quả thi tính theo <strong>sinh viên thuộc khoa</strong>.
    Điểm đã quy về thang 10.
</div>

@* Thống kê nhanh *@
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-primary h-100"><div class="card-body py-2">
            <div class="text-muted small">Khoa</div>
            <div class="fs-4 fw-bold text-primary">@Model.TongKhoa</div>
            <div class="small text-muted">@Model.TongBoMon bộ môn · @Model.TongGiaoVien giảng viên</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-success h-100"><div class="card-body py-2">
            <div class="text-muted small">Sinh viên</div>
            <div class="fs-4 fw-bold text-success">@Model.TongSinhVien</div>
            <div class="small text-muted">
                @Model.TongLop lớp
                @if (Model.SoKhoaChuaCoSinhVien > 0)
                {
                    <span class="text-danger">· @Model.SoKhoaChuaCoSinhVien khoa chưa có sinh viên</span>
                }
            </div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Ngân hàng đề</div>
            <div class="fs-4 fw-bold text-info">@Model.TongCauHoi<span class="fs-6 text-muted"> câu hỏi</span></div>
            <div class="small text-muted">
                @Model.TongDeThi đề thi · @Model.TongMonHoc môn học · @Model.TongHocPhan học phần
            </div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-warning h-100"><div class="card-body py-2">
            <div class="text-muted small">Kết quả thi toàn trường</div>
            <div class="fs-4 fw-bold text-warning">@(Model.DiemTrungBinhHe10?.ToString("0.##") ?? "—")</div>
            <div class="small text-muted">
                @Model.TongBaiDaNop/@Model.TongLuotDuThi bài đã nộp
                @if (Model.TongBaiCoDiem > 0)
                {
                    <text>· @Model.TiLeDat% đạt</text>
                }
                @if (Model.TongBaiChuaCham > 0)
                {
                    <span class="text-danger">· @Model.TongBaiChuaCham chưa chấm</span>
                }
            </div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-3">
    @* Quy mô sinh viên *@
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-people"></i> Quy mô sinh viên theo khoa</h5>
            </div>
            <div class="card-body">
                @if (topSinhVien.Count == 0)
                {
                    <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Chưa có khoa nào có sinh viên.</p>
                }
                else
                {
                    foreach (var k in topSinhVien)
                    {
                        var tiLe = (int)Math.Round(k.SoSinhVien * 100.0 / maxSinhVien);
                        <div class="mb-2">
                            <div class="d-flex justify-content-between small">
                                <a asp-action="KhoaChiTiet" asp-route-id="@k.Id" class="text-decoration-none">@k.TenKhoa</a>
                                <span class="fw-semibold">@k.SoSinhVien</span>
                            </div>
                            <div class="progress" role="progressbar" aria-valuenow="@tiLe" aria-valuemin="0" aria-valuemax="100" style="height:.6rem">
                                <div class="progress-bar bg-success" style="width:@tiLe%"></div>
                            </div>
                            <div class="small text-muted">
                                @k.SoLop lớp · TB @k.SinhVienMoiLop sinh viên/lớp · @k.SoSinhVienNam nam, @k.SoSinhVienNu nữ
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* Ngân hàng câu hỏi *@
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-question-circle"></i> Ngân hàng câu hỏi theo khoa</h5>
            </div>
            <div class="card-body">
                @if (topCauHoi.Count == 0)
                {
                    <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Chưa có khoa nào có câu hỏi.</p>
                }
                else
                {
                    foreach (var k in topCauHoi)
                    {
                        var tiLe = (int)Math.Round(k.SoCauHoi * 100.0 / maxCauHoi);
                        <div class="mb-2">
                            <div class="d-flex justify-content-between small">
                                <a asp-action="KhoaChiTiet" asp-route-id="@k.Id" class="text-decoration-none">@k.TenKhoa</a>
                                <span class="fw-semibold">@k.SoCauHoi</span>
                            </div>
                            <div class="progress" role="progressbar" aria-valuenow="@tiLe" aria-valuemin="0" aria-valuemax="100" style="height:.6rem">
                                <div class="progress-bar bg-info" style="width:@tiLe%"></div>
                            </div>
                            <div class="small text-muted">
                                @k.SoCauHoiTracNghiem trắc nghiệm · @k.SoCauHoiTuLuan tự luận ·
                                @k.SoDeThi đề thi (@k.SoDeThiDaPhatHanh đã phát hành)
                            </div>
                        </div>
                    }
                    if (Model.SoKhoaChuaCoHoatDong > 0)
                    {
                        <hr />
                        <div class="small text-muted">
                            <i class="bi bi-exclamation-circle"></i>
                            @Model.SoKhoaChuaCoHoatDong khoa chưa có câu hỏi / đề thi / lịch thi nào.
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@* Bảng thống kê từng khoa *@
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0"><i class="bi bi-table"></i> Chi tiết theo khoa (@Model.TongKhoa)</h5>
        <div class="d-flex flex-wrap gap-2">
            <select id="locHoatDong" class="form-select form-select-sm w-auto">
                <option value="">-- Tất cả khoa --</option>
                <option value="co">Đã có ngân hàng đề</option>
                <option value="chua">Chưa có ngân hàng đề</option>
            </select>
            <select id="locSinhVien" class="form-select form-select-sm w-auto">
                <option value="">-- Tất cả --</option>
                <option value="co">Đã có sinh viên</option>
                <option value="chua">Chưa có sinh viên</option>
            </select>
        </div>
    </div>
    <div class="card-body">
        <table id="tblThongKeKhoa" class="table table-bordered table-hover align-middle w-100">
            <thead>
                <tr>
                    <th class="bg-primary text-white-50">Mã khoa</th>
                    <th class="bg-primary text-white-50">Tên khoa</th>
                    <th class="bg-primary text-white-50 text-center">Bộ môn</th>
                    <th class="bg-primary text-white-50 text-center">Giảng viên</th>
                    <th class="bg-primary text-white-50 text-center">Lớp</th>
                    <th class="bg-primary text-white-50 text-center">Sinh viên</th>
                    <th class="bg-primary text-white-50 text-center">Môn học</th>
                    <th class="bg-primary text-white-50 text-center">Câu hỏi</th>
                    <th class="bg-primary text-white-50 text-center">Đề thi</th>
                    <th class="bg-primary text-white-50 text-center">Lịch thi</th>
                    <th class="bg-primary text-white-50">Nộp bài</th>
                    <th class="bg-primary text-white-50 text-center">Điểm TB</th>
                    <th class="bg-primary text-white-50 text-center">Tỉ lệ đạt</th>
                    <th class="bg-primary text-white-50 text-center"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model.Khoas)
                {
                    <tr data-hoat-dong="@(k.ChuaCoHoatDong ? "chua" : "co")"
                        data-sinh-vien="@(k.SoSinhVien == 0 ? "chua" : "co")">
                        <td class="fw-semibold">@k.MaKhoa</td>
                        <td>
                            <a asp-action="KhoaChiTiet" asp-route-id="@k.Id" class="text-decoration-none fw-semibold">@k.TenKhoa</a>
                            @if (k.ChuaCoHoatDong)
                            {
                                <div class="small text-muted" title="Chưa có câu hỏi, đề thi hay lịch thi nào"><i class="bi bi-dash-circle"></i> Chưa có ngân hàng đề</div>
                            }
                        </td>
                        <td class="text-center">@k.SoBoMon</td>
                        <td class="text-center">
                            <span class="fw-semibold">@k.SoGiaoVien</span>
                            @if (k.SoGiaoVienDaKhoa > 0)
                            {
                                <div class="small text-danger">@k.SoGiaoVienDaKhoa đã khóa</div>
                            }
                        </td>
                        <td class="text-center">@k.SoLop</td>
                        <td class="text-center">
                            <span class="fw-semibold">@k.SoSinhVien</span>
                            @if (k.SoSinhVien > 0)
                            {
                                <div class="small text-muted">@k.SoSinhVienNam nam / @k.SoSinhVienNu nữ</div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="fw-semibold">@k.SoMonHoc</span>
                            @if (k.SoHocPhan > 0)
                            {
                                <div class="small text-muted">@k.SoHocPhan học phần</div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="fw-semibold">@k.SoCauHoi</span>
                            @if (k.SoCauHoi > 0)
                            {
                                <div class="small text-muted">@k.SoCauHoiTracNghiem TN / @k.SoCauHoiTuLuan TL</div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="fw-semibold">@k.SoDeThi</span>
                            @if (k.SoDeThi > 0)
                            {
                                <div class="small text-muted">@k.SoDeThiDaPhatHanh đã phát hành</div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="fw-semibold">@k.SoLichThi</span>
                            @if (k.SoLichThiDangDienRa > 0)
                            {
                                <div class="small text-success">@k.SoLichThiDangDienRa đang diễn ra</div>
                            }
                        </td>
                        <td data-order="@k.TiLeNop">
                            @if (k.SoLuotDuThi == 0)
                            {
                                <span class="text-muted small">Chưa có lượt dự thi</span>
                            }
                            else
                            {
                                <div class="progress" role="progressbar" aria-valuenow="@k.TiLeNop" aria-valuemin="0" aria-valuemax="100" style="height:1rem;min-width:100px">
                                    <div class="progress-bar bg-success" style="width:@k.TiLeNop%">@k.TiLeNop%</div>
                                </div>
                                <div class="small text-muted">
                                    @k.SoBaiDaNop/@k.SoLuotDuThi bài · @k.SoSinhVienDaThi SV đã thi
                                    @if (k.SoBaiChuaCham > 0)
                                    {
                                        <span class="text-danger">· @k.SoBaiChuaCham chưa chấm</span>
                                    }
                                </div>
                            }
                        </td>
                        <td class="text-center" data-order="@(k.DiemTrungBinhHe10?.ToString("0.00") ?? "-1")">
                            @if (k.DiemTrungBinhHe10.HasValue)
                            {
                                <span class="badge text-bg-@KetQuaLabel.MauXepLoai(k.XepLoai)">@k.DiemTrungBinhHe10.Value.ToString("0.##")</span>
                                <div class="small text-muted">@k.XepLoai</div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center" data-order="@(k.SoBaiCoDiem == 0 ? -1 : k.TiLeDat)">
                            @if (k.SoBaiCoDiem > 0)
                            {
                                <span class="fw-semibold text-@(k.TiLeDat >= 50 ? "success" : "danger")">@k.TiLeDat%</span>
                                <div class="small text-muted">@k.SoBaiDat/@k.SoBaiCoDiem bài</div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="KhoaChiTiet" asp-route-id="@k.Id" class="btn btn-sm btn-outline-primary" title="Xem thống kê chi tiết">
                                <i class="bi bi-bar-chart"></i> Chi tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/thongke-khoa.js" asp-append-version="true"></script>
}
