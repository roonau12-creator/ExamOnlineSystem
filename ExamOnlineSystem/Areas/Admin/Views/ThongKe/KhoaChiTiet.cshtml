@using ExamOnlineSystem.Models.ViewModels
@model ExamOnlineSystem.Models.ViewModels.ThongKeKhoaChiTietVM
@{
    var k = Model.Khoa;
    ViewData["Title"] = "Thống kê " + k.TenKhoa;
    var mauXl = KetQuaLabel.MauXepLoai(k.XepLoai);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="text-black-50 mb-0">
        <i class="bi bi-building"></i> @k.TenKhoa
        <span class="text-muted fs-6">(@k.MaKhoa)</span>
        @if (k.ChuaCoHoatDong)
        {
            <span class="badge fs-6 align-middle text-bg-secondary" title="Chưa có câu hỏi, đề thi hay lịch thi nào">Chưa có ngân hàng đề</span>
        }
    </h3>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="BoMon" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-diagram-3"></i> Bộ môn
        </a>
        <a asp-action="Khoa" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại thống kê</a>
    </div>
</div>

@* Tổ chức & nhân sự *@
<h6 class="text-uppercase text-muted small fw-bold mb-2"><i class="bi bi-people"></i> Tổ chức &amp; nhân sự</h6>
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card border-primary h-100"><div class="card-body py-2">
            <div class="text-muted small">Bộ môn</div>
            <div class="fs-4 fw-bold text-primary">@k.SoBoMon</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-primary h-100"><div class="card-body py-2">
            <div class="text-muted small">Giảng viên</div>
            <div class="fs-4 fw-bold text-primary">@k.SoGiaoVien</div>
            <div class="small text-muted">
                @if (k.SoGiaoVienDaKhoa > 0)
                {
                    <span class="text-danger">@k.SoGiaoVienDaKhoa tài khoản đã khóa</span>
                }
                else
                {
                    <text>Tất cả đang hoạt động</text>
                }
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-success h-100"><div class="card-body py-2">
            <div class="text-muted small">Lớp</div>
            <div class="fs-4 fw-bold text-success">@k.SoLop</div>
            <div class="small text-muted">TB @k.SinhVienMoiLop sinh viên/lớp</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-success h-100"><div class="card-body py-2">
            <div class="text-muted small">Sinh viên</div>
            <div class="fs-4 fw-bold text-success">@k.SoSinhVien</div>
            <div class="small text-muted">@k.SoSinhVienNam nam, @k.SoSinhVienNu nữ</div>
        </div></div>
    </div>
</div>

@* Chương trình & ngân hàng đề *@
<h6 class="text-uppercase text-muted small fw-bold mb-2">
    <i class="bi bi-journal-bookmark"></i> Chương trình &amp; ngân hàng đề
    <span class="fw-normal text-muted">— quy về khoa theo môn học</span>
</h6>
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Môn học</div>
            <div class="fs-4 fw-bold text-info">@k.SoMonHoc</div>
            <div class="small text-muted">@k.SoMonHocHoatDong đang hoạt động · @k.SoHocPhan học phần</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Câu hỏi</div>
            <div class="fs-4 fw-bold text-info">@k.SoCauHoi</div>
            <div class="small text-muted">
                @k.SoCauHoiTracNghiem trắc nghiệm · @k.SoCauHoiTuLuan tự luận · @k.SoDanhMucCauHoi danh mục
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Đề thi</div>
            <div class="fs-4 fw-bold text-info">@k.SoDeThi</div>
            <div class="small text-muted">@k.SoDeThiDaPhatHanh đã phát hành · @k.SoDeThiChuaPhatHanh nháp</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Lớp học phần</div>
            <div class="fs-4 fw-bold text-info">@k.SoLopHocPhan</div>
            <div class="small text-muted">TB @k.CauHoiMoiMonHoc câu hỏi/môn học</div>
        </div></div>
    </div>
</div>

@* Kết quả thi *@
<h6 class="text-uppercase text-muted small fw-bold mb-2">
    <i class="bi bi-clipboard-data"></i> Kết quả thi
    <span class="fw-normal text-muted">— theo sinh viên thuộc khoa; lịch thi theo giảng viên phụ trách</span>
</h6>
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card border-warning h-100"><div class="card-body py-2">
            <div class="text-muted small">Lịch thi</div>
            <div class="fs-4 fw-bold text-warning">@k.SoLichThi</div>
            <div class="small text-muted">@k.SoLichThiDangDienRa đang diễn ra</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-warning h-100"><div class="card-body py-2">
            <div class="text-muted small">Bài đã nộp</div>
            <div class="fs-4 fw-bold text-warning">@k.SoBaiDaNop<span class="fs-6 text-muted">/@k.SoLuotDuThi</span></div>
            <div class="small text-muted">
                @k.SoSinhVienDaThi sinh viên đã thi
                @if (k.SoBaiChuaCham > 0)
                {
                    <span class="text-danger">· @k.SoBaiChuaCham chưa chấm</span>
                }
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-@mauXl h-100"><div class="card-body py-2">
            <div class="text-muted small">Điểm trung bình (hệ 10)</div>
            <div class="fs-4 fw-bold text-@mauXl">@(k.DiemTrungBinhHe10?.ToString("0.##") ?? "—")</div>
            <div class="small text-muted">
                Cao nhất @(k.DiemCaoNhatHe10?.ToString("0.##") ?? "—") ·
                thấp nhất @(k.DiemThapNhatHe10?.ToString("0.##") ?? "—")
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-danger h-100"><div class="card-body py-2">
            <div class="text-muted small">Tỉ lệ đạt (≥ 5)</div>
            <div class="fs-4 fw-bold text-danger">@(k.SoBaiCoDiem == 0 ? "—" : k.TiLeDat + "%")</div>
            <div class="small text-muted">@k.SoBaiDat/@k.SoBaiCoDiem bài đã chấm</div>
        </div></div>
    </div>
</div>

@* Phân bố xếp loại sinh viên *@
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-bar-chart-line"></i> Xếp loại sinh viên theo điểm trung bình</h5>
    </div>
    <div class="card-body">
        @if (k.SoBaiCoDiem == 0)
        {
            <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Khoa chưa có bài thi nào được chấm điểm.</p>
        }
        else
        {
            foreach (var p in Model.PhanBo)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="text-nowrap small" style="width:150px">
                        <span class="badge text-bg-@p.Mau">@p.XepLoai</span>
                        <span class="text-muted">@p.Nhan</span>
                    </div>
                    <div class="progress flex-grow-1" role="progressbar" aria-valuenow="@p.TiLe" aria-valuemin="0" aria-valuemax="100" style="height:1.25rem">
                        <div class="progress-bar bg-@p.Mau" style="width:@p.TiLe%">@(p.TiLe > 8 ? p.TiLe + "%" : "")</div>
                    </div>
                    <div class="text-nowrap small text-muted" style="width:70px">@p.SoLuong SV</div>
                </div>
            }
        }
    </div>
</div>

@* Bộ môn *@
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Bộ môn (@Model.BoMons.Count)</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.BoMons.Count == 0)
        {
            <p class="text-muted m-3 mb-0"><i class="bi bi-info-circle"></i> Khoa chưa có bộ môn nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="bg-primary text-white-50">Mã bộ môn</th>
                            <th class="bg-primary text-white-50">Tên bộ môn</th>
                            <th class="bg-primary text-white-50 text-center">Giảng viên</th>
                            <th class="bg-primary text-white-50 text-center">Môn học</th>
                            <th class="bg-primary text-white-50 text-center">Câu hỏi</th>
                            <th class="bg-primary text-white-50 text-center">Đề thi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.BoMons)
                        {
                            <tr>
                                <td class="fw-semibold">@b.MaBoMon</td>
                                <td>@b.TenBoMon</td>
                                <td class="text-center">@b.SoGiaoVien</td>
                                <td class="text-center">@b.SoMonHoc</td>
                                <td class="text-center">@b.SoCauHoi</td>
                                <td class="text-center">@b.SoDeThi</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Lớp *@
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-people"></i> Lớp của khoa (@Model.Lops.Count)</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Lops.Count == 0)
        {
            <p class="text-muted m-3 mb-0"><i class="bi bi-info-circle"></i> Khoa chưa có lớp nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="bg-primary text-white-50">Mã lớp</th>
                            <th class="bg-primary text-white-50">Tên lớp</th>
                            <th class="bg-primary text-white-50 text-center">Sĩ số</th>
                            <th class="bg-primary text-white-50 text-center">SV đã thi</th>
                            <th class="bg-primary text-white-50 text-center">Bài đã nộp</th>
                            <th class="bg-primary text-white-50 text-center">Điểm TB</th>
                            <th class="bg-primary text-white-50 text-center">Tỉ lệ đạt</th>
                            <th class="bg-primary text-white-50 text-center"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Lops)
                        {
                            <tr>
                                <td class="fw-semibold">@l.MaLop</td>
                                <td>@l.TenLop</td>
                                <td class="text-center">@l.SoSinhVien</td>
                                <td class="text-center">@l.SoSinhVienDaThi</td>
                                <td class="text-center">
                                    @l.SoBaiDaNop<span class="text-muted small">/@l.SoLuotDuThi</span>
                                </td>
                                <td class="text-center">
                                    @if (l.DiemTrungBinhHe10.HasValue)
                                    {
                                        <span class="badge text-bg-@KetQuaLabel.MauXepLoai(KetQuaLabel.XepLoai(l.DiemTrungBinhHe10))">
                                            @l.DiemTrungBinhHe10.Value.ToString("0.##")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (l.SoBaiCoDiem > 0)
                                    {
                                        <span class="fw-semibold text-@(l.TiLeDat >= 50 ? "success" : "danger")">@l.TiLeDat%</span>
                                        <div class="small text-muted">@l.SoBaiDat/@l.SoBaiCoDiem bài</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Lop" asp-action="Details" asp-route-id="@l.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Xem lớp
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Môn học *@
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-journal-bookmark"></i> Môn học của khoa (@Model.MonHocs.Count)</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.MonHocs.Count == 0)
        {
            <p class="text-muted m-3 mb-0"><i class="bi bi-info-circle"></i> Khoa chưa có môn học nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="bg-primary text-white-50">Mã môn</th>
                            <th class="bg-primary text-white-50">Tên môn học</th>
                            <th class="bg-primary text-white-50">Bộ môn</th>
                            <th class="bg-primary text-white-50 text-center">Trạng thái</th>
                            <th class="bg-primary text-white-50 text-center">Học phần</th>
                            <th class="bg-primary text-white-50 text-center">Danh mục</th>
                            <th class="bg-primary text-white-50 text-center">Câu hỏi</th>
                            <th class="bg-primary text-white-50 text-center">Đề thi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.MonHocs)
                        {
                            <tr>
                                <td class="fw-semibold">@m.MaMonHoc</td>
                                <td>@m.TenMonHoc</td>
                                <td>@m.TenBoMon</td>
                                <td class="text-center">
                                    <span class="badge text-bg-@(m.TrangThai == "Hoạt động" ? "success" : "secondary")">@m.TrangThai</span>
                                </td>
                                <td class="text-center">@m.SoHocPhan</td>
                                <td class="text-center">@m.SoDanhMucCauHoi</td>
                                <td class="text-center fw-semibold">@m.SoCauHoi</td>
                                <td class="text-center">
                                    @m.SoDeThi
                                    @if (m.SoDeThi > 0)
                                    {
                                        <div class="small text-muted">@m.SoDeThiDaPhatHanh đã phát hành</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
