@{
    ViewData["Title"] = "Nhập môn học từ Excel";
    var errors = ViewBag.Errors as List<string>;
}
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="bi bi-file-earmark-excel"></i> Nhập môn học từ Excel</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-info small">
                    File <strong>.xlsx</strong>, dòng 1 là tiêu đề, dữ liệu từ dòng 2:
                    <ul class="mb-1 mt-1">
                        <li>Cột A = <strong>Mã môn học</strong>, cột B = <strong>Tên môn học</strong></li>
                        <li>Cột C = <strong>Mã bộ môn</strong> (phải có sẵn; khoa được lấy theo bộ môn)</li>
                        <li>Cột D = <strong>Hình thức thi</strong> (@string.Join(", ", MonHoc.DanhSachHinhThucThi))</li>
                        <li>Cột E = <strong>Thời gian thi</strong> (phút, 1–600), cột F = <strong>Số thứ tự</strong></li>
                        <li>Cột G = <strong>Trạng thái</strong> (@string.Join(", ", MonHoc.DanhSachTrangThai); để trống = @MonHoc.DanhSachTrangThai[0])</li>
                        <li>Cột H = <strong>Mô tả</strong> (không bắt buộc), cột I = <strong>Tên tiếng Anh</strong> (không bắt buộc)</li>
                    </ul>
                    Mã môn học đã tồn tại sẽ được cập nhật, chưa có sẽ được thêm mới.
                    <div class="mt-2">
                        <a asp-action="DownloadTemplate" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-download"></i> Tải file mẫu (kèm danh sách mã bộ môn)
                        </a>
                    </div>
                </div>

                @if (errors != null && errors.Count > 0)
                {
                    <div class="alert alert-danger">
                        <strong>File có lỗi, chưa nhập dữ liệu nào:</strong>
                        <ul class="mb-0">
                            @foreach (var e in errors)
                            {
                                <li>@e</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Import" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label for="file" class="form-label">Chọn file Excel</label>
                        <input type="file" id="file" name="file" class="form-control" accept=".xlsx" required />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-upload"></i> Nhập
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
