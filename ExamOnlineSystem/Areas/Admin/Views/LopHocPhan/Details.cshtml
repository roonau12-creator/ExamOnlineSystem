@using ExamOnlineSystem.Utility
@model ExamOnlineSystem.Models.ViewModels.LopHocPhanDetailVM
@{
    var lhp = Model.LopHocPhan;
    ViewData["Title"] = "Chi tiết lớp học phần " + lhp.MaLopHocPhan;
    var phuTrach = Model.GiaoViens.FirstOrDefault(g => g.VaiTro == LopHocPhanVaiTro.PhuTrach);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="text-black-50 mb-0"><i class="bi bi-collection"></i> Chi tiết lớp học phần</h3>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="PhanCong" asp-route-id="@lhp.Id" class="btn btn-outline-success">
            <i class="bi bi-person-check"></i> Phân công
        </a>
        <a asp-action="Edit" asp-route-id="@lhp.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil-square"></i> Sửa
        </a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h5 class="mb-3">@lhp.MaLopHocPhan – @lhp.TenLopHocPhan</h5>
        <dl class="row mb-0">
            <dt class="col-sm-3">Học phần</dt>
            <dd class="col-sm-9">
                @(lhp.HocPhan?.MaHocPhan) – @(lhp.HocPhan?.TenHocPhan)
                <span class="text-muted">(@(lhp.HocPhan?.SoTinChi) tín chỉ)</span>
            </dd>

            <dt class="col-sm-3">Môn học / Khoa</dt>
            <dd class="col-sm-9">@(lhp.HocPhan?.MonHoc?.TenMonHoc ?? "—") / @(lhp.HocPhan?.Khoa?.TenKhoa ?? "—")</dd>

            <dt class="col-sm-3">Năm học – Học kỳ</dt>
            <dd class="col-sm-9">
                @(lhp.NamHoc?.TenNamHoc ?? "—")
                @if (lhp.NamHoc?.LaNamHienTai == true)
                {
                    <span class="badge bg-success">Năm hiện tại</span>
                }
                · @LopHocPhanLabel.TenHocKy(lhp.HocKy)
            </dd>

            <dt class="col-sm-3">Giảng viên phụ trách</dt>
            <dd class="col-sm-9">
                @if (phuTrach == null)
                {
                    <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Chưa phân công</span>
                }
                else
                {
                    @($"{phuTrach.MaGiaoVien} – {phuTrach.HoTen}")
                }
            </dd>

            <dt class="col-sm-3">Sĩ số</dt>
            <dd class="col-sm-9">
                <span class="badge bg-primary">@Model.SinhViens.Count / @lhp.SiSoToiDa</span>
            </dd>

            <dt class="col-sm-3">Ghi chú</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(lhp.GhiChu) ? "—" : lhp.GhiChu)</dd>
        </dl>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Giảng viên (@Model.GiaoViens.Count)</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.GiaoViens.Count == 0)
                {
                    <div class="p-3 text-muted"><i class="bi bi-info-circle"></i> Chưa phân công giảng viên nào.</div>
                }
                else
                {
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Mã GV</th>
                                <th>Họ tên</th>
                                <th>Bộ môn</th>
                                <th>Vai trò</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var gv in Model.GiaoViens)
                            {
                                <tr>
                                    <td>@gv.MaGiaoVien</td>
                                    <td>@gv.HoTen</td>
                                    <td>@gv.TenBoMon</td>
                                    <td>
                                        <span class="badge @(gv.VaiTro == LopHocPhanVaiTro.PhuTrach ? "bg-success" : "bg-secondary")">
                                            @LopHocPhanLabel.TenVaiTro(gv.VaiTro)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Sinh viên (@Model.SinhViens.Count)</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.SinhViens.Count == 0)
                {
                    <div class="p-3 text-muted"><i class="bi bi-info-circle"></i> Lớp học phần chưa có sinh viên nào.</div>
                }
                else
                {
                    <div style="max-height: 480px; overflow-y: auto">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="position-sticky top-0 bg-white">
                                <tr>
                                    <th>STT</th>
                                    <th>Mã SV</th>
                                    <th>Họ tên</th>
                                    <th>Lớp</th>
                                    <th>Khoa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var stt = 0; }
                                @foreach (var sv in Model.SinhViens)
                                {
                                    stt++;
                                    <tr>
                                        <td>@stt</td>
                                        <td>@sv.MaSinhVien</td>
                                        <td>@sv.HoTen</td>
                                        <td>@sv.MaLop</td>
                                        <td>@sv.TenKhoa</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
