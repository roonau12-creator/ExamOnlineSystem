@model LopHocPhan
@{
    ViewData["Title"] = "Sửa lớp học phần";
}
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Sửa lớp học phần</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <partial name="_LopHocPhanForm" model="Model" />

                    <div class="d-flex justify-content-between gap-2">
                        <a asp-action="PhanCong" asp-route-id="@Model.Id" class="btn btn-outline-success">
                            <i class="bi bi-person-check"></i> Phân công giảng viên, sinh viên
                        </a>
                        <span class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Lưu
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Hủy
                            </a>
                        </span>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
