@{
    ViewData["Title"] = "Nhập danh mục câu hỏi từ Excel";
    var errors = ViewBag.Errors as List<string>;
}
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="bi bi-file-earmark-excel"></i> Nhập danh mục câu hỏi từ Excel</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-info small">
                    File <strong>.xlsx</strong>, dòng 1 là tiêu đề, dữ liệu từ dòng 2:
                    <ul class="mb-2">
                        <li>Cột A = <strong>Mã môn học</strong> (phải có sẵn trong hệ thống)</li>
                        <li>Cột B = <strong>Tên danh mục</strong></li>
                        <li>
                            Cột C = <strong>Danh mục cha</strong>: để trống nếu là danh mục gốc; danh mục nhiều cấp thì ghi đủ
                            đường dẫn từ gốc, ngăn cách bằng <code>&gt;</code>, vd: <code>Ngôn ngữ SQL &gt; Truy vấn nâng cao</code>.
                            Danh mục cha có thể đã có trong hệ thống hoặc nằm ngay trong file.
                        </li>
                        <li>Cột D = <strong>Mô tả</strong> (không bắt buộc)</li>
                    </ul>
                    Danh mục cùng môn học, cùng danh mục cha và cùng tên đã tồn tại sẽ được cập nhật mô tả, chưa có sẽ được thêm mới.
                    <div class="mt-2">
                        <a asp-action="DownloadTemplate" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-download"></i> Tải file mẫu (kèm danh sách mã môn học)
                        </a>
                    </div>
                </div>

                @if (errors != null && errors.Count > 0)
                {
                    <div class="alert alert-danger">
                        <strong>File có lỗi, chưa nhập dữ liệu nào:</strong>
                        <ul class="mb-0">
                            @foreach (var e in errors)
                            {
                                <li>@e</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Import" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label for="file" class="form-label">Chọn file Excel</label>
                        <input type="file" id="file" name="file" class="form-control" accept=".xlsx" required />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-upload"></i> Nhập
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
