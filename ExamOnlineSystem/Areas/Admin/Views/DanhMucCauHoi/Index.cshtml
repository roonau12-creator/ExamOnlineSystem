@{
    ViewData["Title"] = "Quản lý danh mục câu hỏi";
}
<div class="text-center text-black-50">
    <h3>Quản lý danh mục câu hỏi</h3>
</div>
<div class="text-end mb-3">
    <a asp-action="Import" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i>Nhập từ Excel</a>
    <a asp-action="Create" class="btn btn-outline-danger"><i class="bi bi-plus-circle"></i>Thêm danh mục</a>
</div>
<table id="tblDanhMucCauHoi" class="table table-bordered table-hover w-100">
    <thead>
        <tr>
            <th class="bg-primary text-white-50">Tên danh mục</th>
            <th class="bg-primary text-white-50">Danh mục cha</th>
            <th class="bg-primary text-white-50">Cấp</th>
            <th class="bg-primary text-white-50">Môn học</th>
            <th class="bg-primary text-white-50">Mô tả</th>
            <th class="bg-primary text-white-50">Chức năng</th>
        </tr>
    </thead>
</table>

<form id="deleteForm" method="post">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/danhmuccauhoi.js" asp-append-version="true"></script>
}
