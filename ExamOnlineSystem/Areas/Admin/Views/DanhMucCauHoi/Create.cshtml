@model DanhMucCauHoi
@{
    ViewData["Title"] = "Thêm danh mục câu hỏi";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Thêm danh mục câu hỏi</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <partial name="_DanhMucCauHoiForm" model="Model" />

                    <div class="d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Thêm
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/danhmuccauhoi.js" asp-append-version="true"></script>
}
