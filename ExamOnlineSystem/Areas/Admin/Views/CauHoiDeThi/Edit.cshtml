@using ExamOnlineSystem.Models.ViewModels
@using ExamOnlineSystem.Utility
@model CauHoiDeThiFormVM
@{
    var de = (DeThi)ViewData["DeThi"]!;
    var dongGoc = (CauHoiDeThi)ViewData["DongGoc"]!;
    var cauTrongDe = ViewData["CauTrongDe"] as List<(int ThuTu, int CauHoiId, double Diem, string NoiDung)> ?? new();
    var ungVien = ViewData["UngVien"] as List<(CauHoiChonVaoDeVM Cau, string? LyDo)> ?? new();
    ViewData["Title"] = $"Sửa câu {dongGoc.ThuTu} – đề {de.MaDeThi}";
    var tongCacCauKhac = Math.Round(cauTrongDe.Where(c => c.ThuTu != dongGoc.ThuTu).Sum(c => c.Diem), 2);
    var urlHuy = Model.ReturnUrl ?? Url.Action("Details", "DeThi", new { id = de.Id });
    string RutGon(string s, int n) => s.Length > n ? s[..n] + "…" : s;
}
<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Sửa câu @dongGoc.ThuTu trong đề @de.MaDeThi</h4>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Đề <strong>@de.MaDeThi – @de.TenDeThi</strong> (@DeThiLabel.TenLoaiDeThi(de.LoaiDeThi), tổng điểm @de.TongDiem).
                    Có thể đổi sang câu hỏi khác, đổi điểm hoặc đổi vị trí của câu trong đề.
                </p>

                <form asp-action="Edit" method="post" id="frmSuaCauDe">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="DeThiId" />
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="CauHoiId" class="form-label"></label>
                        <select asp-for="CauHoiId" class="form-select">
                            @foreach (var (c, lyDo) in ungVien)
                            {
                                var laHienTai = c.Id == dongGoc.CauHoiId;
                                <option value="@c.Id" data-diem="@c.DiemMacDinh" disabled="@(lyDo != null)" title="@c.NoiDung">
                                    #@c.Id · @CauHoiLabel.TenLoaiCauHoi(c.LoaiCauHoi) · @CauHoiLabel.TenMucDo(c.MucDo) · @(c.DiemMacDinh)đ — @RutGon(c.NoiDung, 70)@(laHienTai ? " (câu hiện tại)" : lyDo != null ? $" ({lyDo})" : "")
                                </option>
                            }
                        </select>
                        <div class="form-text" id="ghiChuDoiCau">
                            Chỉ đổi được sang câu cùng môn, phù hợp loại đề và chưa có trong đề.
                            @if (dongGoc.ThuTuDapAn != null)
                            {
                                <span class="text-warning">Câu này đang trộn đáp án — đổi sang câu khác sẽ dùng thứ tự đáp án gốc của câu mới.</span>
                            }
                        </div>
                        <span asp-validation-for="CauHoiId" class="text-danger"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Diem" class="form-label"></label>
                            <input asp-for="Diem" type="number" step="0.25" min="0.25" class="form-control" />
                            <span asp-validation-for="Diem" class="text-danger"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="ViTri" class="form-label"></label>
                            <select asp-for="ViTri" class="form-select">
                                @foreach (var c in cauTrongDe)
                                {
                                    <option value="@c.ThuTu">
                                        Câu @c.ThuTu@(c.ThuTu == dongGoc.ThuTu ? " (vị trí hiện tại)" : $" — đổi chỗ với #{c.CauHoiId}: {RutGon(c.NoiDung, 40)}")
                                    </option>
                                }
                            </select>
                            <div class="form-text">Chuyển câu tới vị trí mới, các câu khác tự dồn lại.</div>
                            <span asp-validation-for="ViTri" class="text-danger"></span>
                        </div>
                    </div>

                    <div id="tongDiem" class="alert py-2 small" data-tong-khac="@tongCacCauKhac" data-tong-de="@de.TongDiem"></div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Lưu
                        </button>
                        <a href="@urlHuy" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Đổi câu => gợi ý điểm mặc định của câu mới; luôn hiện trước tổng điểm đề sau khi sửa
        $(function () {
            var $cau = $("#CauHoiId"), $diem = $("#Diem"), $tong = $("#tongDiem");
            var cauBanDau = $cau.val();
            var tongKhac = parseFloat($tong.data("tong-khac")) || 0, tongDe = parseFloat($tong.data("tong-de")) || 0;
            function lamTron(x) { return Math.round(x * 100) / 100; }
            function capNhat() {
                var sau = lamTron(tongKhac + (parseFloat($diem.val()) || 0));
                var khop = Math.abs(sau - tongDe) < 0.001;
                $tong.toggleClass("alert-success", khop).toggleClass("alert-warning", !khop)
                     .html("Tổng điểm các câu sau khi sửa: <strong>" + sau + "</strong> / tổng điểm đề <strong>" + tongDe + "</strong>" +
                           (khop ? ' <i class="bi bi-check-circle-fill"></i>'
                                 : " — " + (sau < tongDe ? "còn thiếu " + lamTron(tongDe - sau) : "thừa " + lamTron(sau - tongDe)) + " điểm"));
            }
            $cau.on("change", function () {
                if ($cau.val() !== cauBanDau) {
                    $diem.val($cau.find("option:selected").data("diem"));
                }
                capNhat();
            });
            $diem.on("input change", capNhat);
            capNhat();
        });
    </script>
}
