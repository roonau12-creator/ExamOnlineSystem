@{
    ViewData["Title"] = "Theo dõi kết quả thi";
}
<div class="text-center text-black-50">
    <h3><i class="bi bi-clipboard-data"></i> Theo dõi kết quả thi</h3>
    <p class="small">Tổng hợp tiến độ làm bài và kết quả của từng lịch thi. Điểm hiển thị đã quy về thang 10.</p>
</div>

@* Thống kê nhanh toàn hệ thống (ketquathi.js điền) *@
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-primary h-100"><div class="card-body py-2">
            <div class="text-muted small">Lịch thi có kết quả</div>
            <div class="fs-4 fw-bold text-primary" data-tk="soLichThi">0</div>
            <div class="small text-muted"><span data-tk="soDangDienRa">0</span> đang diễn ra</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-success h-100"><div class="card-body py-2">
            <div class="text-muted small">Bài đã nộp</div>
            <div class="fs-4 fw-bold text-success" data-tk="soDaNop">0</div>
            <div class="small text-muted">trên <span data-tk="soSinhVien">0</span> lượt dự thi</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Điểm trung bình</div>
            <div class="fs-4 fw-bold text-info" data-tk="diemTrungBinh">—</div>
            <div class="small text-muted">thang 10</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-warning h-100"><div class="card-body py-2">
            <div class="text-muted small">Tỉ lệ đạt</div>
            <div class="fs-4 fw-bold text-warning" data-tk="tiLeDat">—</div>
            <div class="small text-muted">còn <span data-tk="soChuaCham">0</span> bài chưa chấm</div>
        </div></div>
    </div>
</div>

@* Bộ lọc nhanh *@
<div class="row g-2 mb-3">
    <div class="col-sm-6 col-md-3">
        <select id="locTrangThai" class="form-select">
            <option value="">-- Tất cả trạng thái --</option>
            <option>Sắp diễn ra</option>
            <option>Đang diễn ra</option>
            <option>Đã kết thúc</option>
        </select>
    </div>
    <div class="col-sm-6 col-md-3">
        <select id="locMonHoc" class="form-select">
            <option value="">-- Tất cả môn học --</option>
        </select>
    </div>
    <div class="col-sm-6 col-md-3">
        <select id="locLop" class="form-select">
            <option value="">-- Tất cả lớp --</option>
        </select>
    </div>
    <div class="col-sm-6 col-md-3 form-check d-flex align-items-center ps-md-4">
        <input class="form-check-input me-2 mt-0" type="checkbox" id="chiCoKetQua" />
        <label class="form-check-label" for="chiCoKetQua">Chỉ lịch thi đã có bài nộp</label>
    </div>
</div>

<table id="tblKetQuaThi" class="table table-bordered table-hover align-middle w-100">
    <thead>
        <tr>
            <th class="bg-primary text-white-50">Lịch thi</th>
            <th class="bg-primary text-white-50">Môn học</th>
            <th class="bg-primary text-white-50">Thời gian</th>
            <th class="bg-primary text-white-50 text-center">Trạng thái</th>
            <th class="bg-primary text-white-50">Tiến độ nộp bài</th>
            <th class="bg-primary text-white-50 text-center">Điểm TB</th>
            <th class="bg-primary text-white-50 text-center">Cao nhất</th>
            <th class="bg-primary text-white-50 text-center">Thấp nhất</th>
            <th class="bg-primary text-white-50 text-center">Tỉ lệ đạt</th>
            <th class="bg-primary text-white-50 text-center">Chức năng</th>
        </tr>
    </thead>
</table>

@section Scripts {
    <script src="~/js/ketquathi.js" asp-append-version="true"></script>
}
