@using ExamOnlineSystem.Models
@using ExamOnlineSystem.Models.ViewModels
@using ExamOnlineSystem.Utility
@model ExamOnlineSystem.Models.ViewModels.BaiThiChiTietVM
@{
    ViewData["Title"] = $"Bài làm của {Model.HoTen}";
    var batDau = Model.ThoiGianBatDau.ToLocalTime();
    var mauTt = Model.TrangThai == 1 ? "success" : Model.TrangThai >= 2 ? "danger" : "warning";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="text-black-50 mb-0">
        <i class="bi bi-file-earmark-check"></i> Bài làm của sinh viên
        <span class="badge fs-6 align-middle text-bg-@mauTt">@KetQuaLabel.TenTrangThaiLanThi(Model.TrangThai)</span>
    </h3>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Details" asp-route-id="@Model.LichThiId" class="btn btn-outline-primary">
            <i class="bi bi-clipboard-data"></i> Kết quả lịch thi
        </a>
        <a asp-controller="DeThi" asp-action="XemTruoc" asp-route-id="@Model.DeThiId" class="btn btn-outline-secondary">
            <i class="bi bi-eye"></i> Xem đề gốc
        </a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
</div>

@* Thông tin sinh viên / lần thi *@
<div class="card shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="row g-3">
            <div class="col-lg-4">
                <h5 class="mb-1">@Model.HoTen <span class="text-muted fs-6">(@Model.MaSinhVien)</span></h5>
                <div class="small text-muted"><i class="bi bi-people"></i> @Model.MaLop @(string.IsNullOrWhiteSpace(Model.TenLop) ? "" : "– " + Model.TenLop)</div>
                <div class="small text-muted"><i class="bi bi-arrow-repeat"></i> Lần thi thứ @Model.LanThu</div>
            </div>
            <div class="col-lg-4">
                <div class="small"><i class="bi bi-journal-bookmark"></i> @Model.TenMonHoc</div>
                <div class="small text-muted">
                    <i class="bi bi-file-earmark-text"></i>
                    <a asp-controller="DeThi" asp-action="Details" asp-route-id="@Model.DeThiId">@Model.MaDeThi</a> – @Model.TenDeThi
                </div>
                <div class="small text-muted"><i class="bi bi-calendar-event"></i> @Model.TenLichThi</div>
            </div>
            <div class="col-lg-4">
                <div class="small"><i class="bi bi-play-circle"></i> Bắt đầu: @batDau.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small"><i class="bi bi-stop-circle"></i> Nộp bài:
                    @(Model.ThoiGianNopBai?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                </div>
                <div class="small text-muted">
                    <i class="bi bi-hourglass-split"></i>
                    @(Model.SoPhutLamBai.HasValue ? Model.SoPhutLamBai.Value + " phút" : "—") / @Model.ThoiLuong phút
                </div>
            </div>
        </div>
    </div>
</div>

@* Tổng hợp bài làm *@
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Điểm bài thi</div>
            <div class="fs-4 fw-bold text-info">
                @(Model.Diem?.ToString("0.##") ?? "—")<span class="fs-6 text-muted">/@Model.TongDiem.ToString("0.##")</span>
            </div>
            <div class="small text-muted">
                Hệ 10: @(Model.DiemHe10?.ToString("0.##") ?? "—") ·
                <span class="text-@KetQuaLabel.MauXepLoai(KetQuaLabel.XepLoai(Model.DiemHe10))">@KetQuaLabel.XepLoai(Model.DiemHe10)</span>
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-success h-100"><div class="card-body py-2">
            <div class="text-muted small">Trắc nghiệm đúng</div>
            <div class="fs-4 fw-bold text-success">@Model.SoCauDung<span class="fs-6 text-muted">/@Model.SoCauTracNghiem</span></div>
            <div class="small text-muted">Sai @Model.SoCauSai · được @Model.DiemTracNghiem.ToString("0.##") điểm</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-primary h-100"><div class="card-body py-2">
            <div class="text-muted small">Tự luận đã chấm</div>
            <div class="fs-4 fw-bold text-primary">@Model.SoCauDaCham<span class="fs-6 text-muted">/@Model.SoCauTuLuan</span></div>
            <div class="small text-muted">
                @if (Model.SoCauChuaCham > 0)
                {
                    <span class="text-danger">Còn @Model.SoCauChuaCham câu chưa chấm</span>
                }
                else
                {
                    <text>Được @Model.DiemTuLuan.ToString("0.##") điểm</text>
                }
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-warning h-100"><div class="card-body py-2">
            <div class="text-muted small">Câu đã làm</div>
            <div class="fs-4 fw-bold text-warning">@Model.SoCauDaLam<span class="fs-6 text-muted">/@Model.SoCau</span></div>
            <div class="small text-muted">
                Bỏ trống @Model.SoCauBoTrong câu · tổng điểm đã chấm @Model.DiemDaCham.ToString("0.##")
            </div>
        </div></div>
    </div>
</div>

@* Bộ lọc câu hỏi *@
<div class="d-flex flex-wrap gap-2 mb-3" id="locCauHoi">
    <span class="small text-muted align-self-center me-1">Lọc câu hỏi:</span>
    <button type="button" class="btn btn-sm btn-primary" data-loc="">Tất cả (@Model.SoCau)</button>
    <button type="button" class="btn btn-sm btn-outline-success" data-loc="@KetQuaCau.Dung">Đúng (@Model.SoCauDung)</button>
    <button type="button" class="btn btn-sm btn-outline-danger" data-loc="@KetQuaCau.Sai">Sai (@Model.SoCauSai)</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-loc="@KetQuaCau.BoTrong">Bỏ trống (@Model.SoCauBoTrong)</button>
    <button type="button" class="btn btn-sm btn-outline-info" data-loc="@KetQuaCau.DaCham">Tự luận đã chấm (@Model.SoCauDaCham)</button>
    <button type="button" class="btn btn-sm btn-outline-warning" data-loc="@KetQuaCau.ChuaCham">Chưa chấm (@Model.SoCauChuaCham)</button>
</div>

@if (Model.CauHois.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Lần thi này chưa có câu hỏi nào được ghi nhận.
    </div>
}
else
{
    <div id="dsCauHoi">
        @foreach (var c in Model.CauHois)
        {
            var ketQua = c.KetQua;
            var mauKq = KetQuaCau.Mau(ketQua);
            <div class="card shadow-sm mb-3 border-@mauKq cauhoi-item" data-loc="@ketQua">
                <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="fw-semibold">
                        Câu @c.ThuTu
                        <span class="badge text-bg-light text-dark border">@CauHoiLabel.TenLoaiCauHoi(c.LoaiCauHoi)</span>
                    </span>
                    <span class="d-flex align-items-center gap-2">
                        <span class="badge text-bg-@mauKq">@KetQuaCau.Ten(ketQua)</span>
                        <span class="small text-muted">
                            @(ketQua == KetQuaCau.ChuaCham ? "—" : c.DiemDatDuoc.ToString("0.##"))
                            / @c.DiemToiDa.ToString("0.##") điểm
                        </span>
                    </span>
                </div>
                <div class="card-body">
                    <div class="mb-3" style="white-space: pre-line">@c.NoiDung</div>

                    @if (c.LoaiCauHoi == 2)
                    {
                        <div class="mb-2">
                            <div class="small text-muted mb-1">Câu trả lời của sinh viên:</div>
                            @if (string.IsNullOrWhiteSpace(c.NoiDungTraLoi))
                            {
                                <div class="alert alert-secondary py-2 mb-0"><i class="bi bi-dash-circle"></i> Sinh viên không trả lời câu này.</div>
                            }
                            else
                            {
                                <div class="border rounded bg-light p-3" style="white-space: pre-line">@c.NoiDungTraLoi</div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(c.NhanXet))
                        {
                            <div class="alert alert-info py-2 mb-0">
                                <i class="bi bi-chat-left-text"></i> <strong>Nhận xét của giảng viên:</strong> @c.NhanXet
                            </div>
                        }
                        else if (ketQua == KetQuaCau.ChuaCham)
                        {
                            <div class="alert alert-warning py-2 mb-0">
                                <i class="bi bi-exclamation-triangle"></i> Câu tự luận này chưa được chấm điểm.
                            </div>
                        }
                    }
                    else
                    {
                        <ul class="list-group">
                            @for (var i = 0; i < c.DapAns.Count; i++)
                            {
                                var d = c.DapAns[i];
                                var lopDong = d.DaChon && d.LaDapAnDung ? "list-group-item-success"
                                            : d.DaChon ? "list-group-item-danger"
                                            : d.LaDapAnDung ? "list-group-item-light border-success" : "";
                                <li class="list-group-item d-flex align-items-start gap-2 @lopDong">
                                    <span class="fw-semibold">@ThuTuDapAnHelper.Nhan(i).</span>
                                    <span class="flex-grow-1">@d.NoiDung</span>
                                    <span class="text-nowrap small">
                                        @if (d.DaChon)
                                        {
                                            <span class="badge text-bg-@(d.LaDapAnDung ? "success" : "danger")">
                                                <i class="bi bi-person-check"></i> Sinh viên chọn
                                            </span>
                                        }
                                        @if (d.LaDapAnDung)
                                        {
                                            <span class="badge text-bg-success"><i class="bi bi-check-lg"></i> Đáp án đúng</span>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                        @if (c.DapAns.Count == 0)
                        {
                            <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Câu hỏi này không có đáp án nào được lưu.</p>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        // Lọc nhanh danh sách câu hỏi theo kết quả
        $(function () {
            $("#locCauHoi").on("click", "button", function () {
                var loc = $(this).data("loc");
                $("#locCauHoi button").each(function () {
                    var chon = $(this).data("loc") === loc;
                    var mau = { "": "primary", dung: "success", sai: "danger", dacham: "info", chuacham: "warning" }[this.dataset.loc] || "secondary";
                    $(this).toggleClass("btn-" + mau, chon).toggleClass("btn-outline-" + mau, !chon);
                });
                $(".cauhoi-item").each(function () {
                    $(this).toggle(!loc || this.dataset.loc === loc);
                });
            });
        });
    </script>
}
