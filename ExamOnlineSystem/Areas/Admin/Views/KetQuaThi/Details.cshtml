@using ExamOnlineSystem.Models.ViewModels
@model ExamOnlineSystem.Models.ViewModels.KetQuaThiChiTietVM
@{
    var th = Model.TongHop;
    ViewData["Title"] = "Kết quả thi " + th.TenLichThi;

    var batDau = th.ThoiGianBatDau.ToLocalTime();
    var ketThuc = th.ThoiGianKetThuc.ToLocalTime();
    var cungNgay = batDau.Date == ketThuc.Date;
    var dangDienRa = Model.TrangThai == TrangThaiLichThi.DangDienRa;

    var mau = Model.TrangThai == TrangThaiLichThi.SapDienRa ? "info"
            : dangDienRa ? "success"
            : "secondary";

    var cacLop = Model.SinhViens.Select(s => s.MaLop).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="text-black-50 mb-0">
        <i class="bi bi-clipboard-data"></i> Theo dõi kết quả thi
        <span class="badge fs-6 align-middle text-bg-@mau">@Model.TrangThai</span>
    </h3>
    <div class="d-flex flex-wrap gap-2">
        @if (dangDienRa)
        {
            <div class="form-check form-switch align-self-center me-1">
                <input class="form-check-input" type="checkbox" role="switch" id="tuDongLamMoi" checked />
                <label class="form-check-label small" for="tuDongLamMoi">Tự động làm mới (15 giây)</label>
            </div>
        }
        <button type="button" id="btnLamMoi" class="btn btn-outline-primary" data-id="@th.Id">
            <i class="bi bi-arrow-clockwise"></i> Làm mới
        </button>
        @if (th.SoCoDiem > 0)
        {
            <a asp-action="XuatExcel" asp-route-id="@th.Id" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-excel"></i> Xuất bảng điểm
            </a>
        }
        <a asp-controller="LichThi" asp-action="Details" asp-route-id="@th.Id" class="btn btn-outline-secondary">
            <i class="bi bi-calendar-event"></i> Chi tiết lịch thi
        </a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
</div>

@* Thông tin lịch thi *@
<div class="card shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="row g-3">
            <div class="col-lg-5">
                <h5 class="mb-1">@th.TenLichThi</h5>
                <div class="small text-muted">
                    <i class="bi bi-journal-bookmark"></i> @th.TenMonHoc ·
                    <i class="bi bi-file-earmark-text"></i>
                    <a asp-controller="DeThi" asp-action="Details" asp-route-id="@th.DeThiId">@th.MaDeThi</a> – @th.TenDeThi
                </div>
                <div class="small text-muted">
                    <i class="bi bi-people"></i> @(th.Lops.Count == 0 ? "—" : string.Join(", ", th.Lops))
                </div>
            </div>
            <div class="col-lg-4">
                <div class="small"><i class="bi bi-clock"></i>
                    @batDau.ToString("dd/MM/yyyy HH:mm") –
                    @(cungNgay ? ketThuc.ToString("HH:mm") : ketThuc.ToString("dd/MM/yyyy HH:mm"))
                </div>
                <div class="small text-muted">Thời gian làm bài @th.ThoiLuong phút · Thang điểm @th.TongDiem.ToString("0.##")</div>
                <div class="small text-muted"><i class="bi bi-person-workspace"></i> @(string.IsNullOrWhiteSpace(th.TenGiaoVien) ? "—" : th.TenGiaoVien)</div>
            </div>
            <div class="col-lg-3">
                <div class="small text-muted mb-1">Tiến độ nộp bài</div>
                <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" style="height:1.25rem">
                    <div class="progress-bar bg-success @(dangDienRa ? "progress-bar-striped progress-bar-animated" : "")"
                         id="thanhTienDo" style="width:@th.TiLeNop%">@th.TiLeNop%</div>
                </div>
                <div class="small text-muted mt-1"><span data-tk="soDaNop">@th.SoDaNop</span>/@th.SoSinhVien sinh viên</div>
            </div>
        </div>
    </div>
</div>

@* Thống kê nhanh *@
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card border-secondary h-100"><div class="card-body py-2">
            <div class="text-muted small">Chưa thi</div>
            <div class="fs-4 fw-bold text-secondary" data-tk="soChuaThi">@th.SoChuaThi</div>
            <div class="small text-muted">Đang làm bài: <span data-tk="soDangThi">@th.SoDangThi</span></div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-success h-100"><div class="card-body py-2">
            <div class="text-muted small">Đã nộp bài</div>
            <div class="fs-4 fw-bold text-success" data-tk="soDaNopLon">@th.SoDaNop</div>
            <div class="small text-muted">Chưa chấm: <span data-tk="soChuaCham">@th.SoChuaCham</span></div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-info h-100"><div class="card-body py-2">
            <div class="text-muted small">Điểm trung bình (hệ 10)</div>
            <div class="fs-4 fw-bold text-info" data-tk="diemTrungBinh">@(th.DiemTrungBinhHe10?.ToString("0.##") ?? "—")</div>
            <div class="small text-muted">
                Cao nhất <span data-tk="diemCaoNhat">@(th.DiemCaoNhatHe10?.ToString("0.##") ?? "—")</span> ·
                thấp nhất <span data-tk="diemThapNhat">@(th.DiemThapNhatHe10?.ToString("0.##") ?? "—")</span>
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-warning h-100"><div class="card-body py-2">
            <div class="text-muted small">Tỉ lệ đạt (≥ 5)</div>
            <div class="fs-4 fw-bold text-warning" data-tk="tiLeDat">@(th.SoCoDiem == 0 ? "—" : th.TiLeDat + "%")</div>
            <div class="small text-muted"><span data-tk="soDat">@th.SoDat</span>/<span data-tk="soCoDiem">@th.SoCoDiem</span> bài đã chấm</div>
        </div></div>
    </div>
</div>

@* Phân bố điểm *@
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-bar-chart-line"></i> Phân bố điểm (thang 10)</h5>
    </div>
    <div class="card-body" id="phanBoDiem">
        @if (th.SoCoDiem == 0)
        {
            <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Chưa có bài thi nào được chấm điểm.</p>
        }
        else
        {
            foreach (var k in Model.PhanBo)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="text-nowrap small" style="width:150px">
                        <span class="badge text-bg-@k.Mau">@k.XepLoai</span>
                        <span class="text-muted">@k.Nhan</span>
                    </div>
                    <div class="progress flex-grow-1" role="progressbar" aria-valuenow="@k.TiLe" aria-valuemin="0" aria-valuemax="100" style="height:1.25rem">
                        <div class="progress-bar bg-@k.Mau" style="width:@k.TiLe%">@(k.TiLe > 8 ? k.TiLe + "%" : "")</div>
                    </div>
                    <div class="text-nowrap small text-muted" style="width:90px">@k.SoLuong bài (@k.TiLe%)</div>
                </div>
            }
        }
    </div>
</div>

@* Bảng kết quả theo sinh viên *@
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0"><i class="bi bi-person-lines-fill"></i> Kết quả theo sinh viên (@Model.SinhViens.Count)</h5>
        <div class="d-flex flex-wrap gap-2">
            <select id="locTrangThaiSv" class="form-select form-select-sm w-auto">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="0">Chưa thi</option>
                <option value="1">Đang làm bài</option>
                <option value="2">Đã nộp bài</option>
            </select>
            <select id="locKetQua" class="form-select form-select-sm w-auto">
                <option value="">-- Tất cả kết quả --</option>
                <option value="dat">Đạt (≥ 5)</option>
                <option value="khongdat">Không đạt (&lt; 5)</option>
                <option value="chuacham">Chưa chấm</option>
            </select>
            @if (cacLop.Count > 1)
            {
                <select id="locLopSv" class="form-select form-select-sm w-auto">
                    <option value="">-- Tất cả lớp --</option>
                    @foreach (var ma in cacLop)
                    {
                        <option value="@ma">@ma</option>
                    }
                </select>
            }
        </div>
    </div>
    <div class="card-body">
        @if (Model.SinhViens.Count == 0)
        {
            <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Lịch thi chưa có sinh viên dự thi.</p>
        }
        else
        {
            <table id="tblKetQuaSinhVien" class="table table-bordered table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th class="bg-primary text-white-50 text-center">STT</th>
                        <th class="bg-primary text-white-50">Mã SV</th>
                        <th class="bg-primary text-white-50">Họ tên</th>
                        <th class="bg-primary text-white-50">Lớp</th>
                        <th class="bg-primary text-white-50 text-center">Trạng thái</th>
                        <th class="bg-primary text-white-50 text-center">Lần thi</th>
                        <th class="bg-primary text-white-50 text-center">Bắt đầu</th>
                        <th class="bg-primary text-white-50 text-center">Nộp bài</th>
                        <th class="bg-primary text-white-50 text-center">Làm bài</th>
                        <th class="bg-primary text-white-50 text-center">Điểm</th>
                        <th class="bg-primary text-white-50 text-center">Hệ 10</th>
                        <th class="bg-primary text-white-50 text-center">Xếp loại</th>
                        <th class="bg-primary text-white-50 text-center">Bài làm</th>
                    </tr>
                </thead>
                <tbody id="bangKetQua">
                    @for (var i = 0; i < Model.SinhViens.Count; i++)
                    {
                        var sv = Model.SinhViens[i];
                        <tr data-trang-thai="@sv.TrangThai"
                            data-lop="@sv.MaLop"
                            data-ket-qua="@(sv.DiemHe10 == null ? "chuacham" : sv.Dat ? "dat" : "khongdat")">
                            <td class="text-center">@(i + 1)</td>
                            <td>@sv.MaSinhVien</td>
                            <td>@sv.HoTen</td>
                            <td>@sv.MaLop</td>
                            <td class="text-center">
                                <span class="badge text-bg-@KetQuaLabel.MauTrangThai(sv.TrangThai)">@KetQuaLabel.TenTrangThai(sv.TrangThai)</span>
                            </td>
                            <td class="text-center">@(sv.SoLanThi == 0 ? "—" : sv.SoLanThi.ToString())</td>
                            <td class="text-center text-nowrap" data-order="@(sv.ThoiGianBatDau?.ToString("yyyyMMddHHmm") ?? "")">
                                @(sv.ThoiGianBatDau?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")
                            </td>
                            <td class="text-center text-nowrap" data-order="@(sv.ThoiGianNopBai?.ToString("yyyyMMddHHmm") ?? "")">
                                @(sv.ThoiGianNopBai?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")
                            </td>
                            <td class="text-center" data-order="@(sv.SoPhutLamBai ?? -1)">
                                @(sv.SoPhutLamBai.HasValue ? sv.SoPhutLamBai.Value + " phút" : "—")
                            </td>
                            <td class="text-center fw-semibold" data-order="@(sv.Diem?.ToString("0.00") ?? "-1")">
                                @(sv.Diem?.ToString("0.##") ?? "—")
                            </td>
                            <td class="text-center" data-order="@(sv.DiemHe10?.ToString("0.00") ?? "-1")">
                                @if (sv.DiemHe10.HasValue)
                                {
                                    <span class="badge text-bg-@KetQuaLabel.MauXepLoai(sv.XepLoai)">@sv.DiemHe10.Value.ToString("0.##")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="text-@KetQuaLabel.MauXepLoai(sv.XepLoai)">@sv.XepLoai</span>
                            </td>
                            <td class="text-center">
                                @if (sv.LanThiId.HasValue)
                                {
                                    <a asp-action="BaiLam" asp-route-id="@sv.LanThiId" class="btn btn-sm btn-outline-primary" title="Xem bài làm">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/ketquathi-theodoi.js" asp-append-version="true"></script>
}
